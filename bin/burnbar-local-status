#!/usr/bin/env python3
"""Report the Ollama box, residency over HTTP, hardware locally or over ssh.

A compute GPU is NVIDIA, AMD, or a Jetson. Intel integrated graphics does
not count: that is a display adapter, not a place models run. --discover
answers that question without talking to Ollama, so the widget can hide
the local lane on a GPU-less machine instead of polling a dead nano.

When the configured host is this machine, telemetry is local (nvidia-smi
or Jetson sysfs). When it is another box, one ssh snippet reads the
Jetson's sysfs: GPU load and clock from the nvgpu devfreq node,
temperatures, INA3221 rails, fan PWM, unified memory, and the ollama
processes' CPU ticks sampled 200 ms apart. nvidia-smi on a Jetson
answers [N/A] to every query; sysfs is instant and needs no privilege.

Either HTTP or hardware can fail on its own. No HTTP means OFFLINE. No
hardware figures are withheld with the reason in telemetryError, not
zeros that look like an idle board.
"""

import argparse
import json
import math
import os
import shutil
import socket
import subprocess
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


MAX_HTTP_RESPONSE_BYTES = 1024 * 1024
MAX_MODELS = 128
MAX_TEXT_LENGTH = 256
MAX_ERROR_LENGTH = 512
HTTP_TIMEOUT = 2.0
SSH_TIMEOUT = 8

# PCI display/3D controllers that can actually run models. Intel (0x8086)
# is the laptop iGPU; counting it made every Ultrabook look like a GPU box.
COMPUTE_GPU_VENDORS = {
    "0x10de": "NVIDIA",
    "0x1002": "AMD",
}

# Runs on the Ollama box. Prints "key value…" lines; every read is a sysfs
# or /proc file, so a missing one costs a blank line, never a hang. The
# 200 ms sleep is the CPU sample window.
TELEMETRY_SNIPPET = r'''
G=/sys/devices/platform/bus@0/17000000.gpu
ticks() { t=0; for p in /proc/[0-9]*; do [ "$(cat $p/comm 2>/dev/null)" = ollama ] || continue; set -- $(cat $p/stat 2>/dev/null); t=$((t + ${14:-0} + ${15:-0})); done; echo $t; }
total() { set -- $(grep "^cpu " /proc/stat); echo $(($2+$3+$4+$5+$6+$7+$8)); }
t1=$(ticks); c1=$(total); sleep 0.2; t2=$(ticks); c2=$(total)
echo "cpu_ticks $((t2-t1)) $((c2-c1))"
echo "gpu_load $(cat $G/load 2>/dev/null)"
echo "gpu_hz $(cat $G/devfreq/17000000.gpu/cur_freq 2>/dev/null) $(cat $G/devfreq/17000000.gpu/max_freq 2>/dev/null)"
for z in /sys/class/thermal/thermal_zone*; do case "$(cat $z/type 2>/dev/null)" in gpu-thermal) echo "temp_gpu $(cat $z/temp 2>/dev/null)";; esac; done
for h in /sys/class/hwmon/hwmon*; do case "$(cat $h/name 2>/dev/null)" in
  ina3221) for i in 1 2 3; do echo "rail_$(cat $h/in${i}_label 2>/dev/null) $(cat $h/in${i}_input 2>/dev/null) $(cat $h/curr${i}_input 2>/dev/null)"; done;;
  pwmfan) echo "fan_pwm $(cat $h/pwm1 2>/dev/null)";;
esac; done
echo "mem $(awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} END{print t, a}' /proc/meminfo)"
echo "model $(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
'''


def bounded_text(value, limit: int = MAX_TEXT_LENGTH) -> str:
    text = str(value or "")
    text = "".join(character if character.isprintable() else " " for character in text)
    return text[:limit]


def normalize_url(url: str) -> str:
    url = url.strip()
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme.lower() in ("http", "https") and not parsed.netloc:
        raise ValueError("Ollama URL must use http or https with a host")
    url = url if "://" in url else "http://" + url
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme.lower() not in ("http", "https") or not parsed.netloc or not parsed.hostname:
        raise ValueError("Ollama URL must use http or https with a host")
    try:
        parsed.port
    except ValueError as error:
        raise ValueError("Ollama URL has an invalid port") from error
    # Endpoint paths are appended to this string; a query or fragment would
    # swallow them ("?key=a/api/ps" is a query, "#x/api/ps" is never sent).
    if parsed.query or parsed.fragment:
        raise ValueError("Ollama URL must not carry a query or fragment")
    return url.rstrip("/")


def ssh_host(value: str) -> str:
    """An ssh destination as the user configured it. Only the shape that can
    turn into an option is refused: a leading '-' is how a host name becomes
    a flag, and '--' stops that."""
    text = str(value or "").strip()
    if not text or len(text) > 128 or not text.isprintable() or any(c.isspace() for c in text) or text.startswith("-"):
        raise ValueError("ssh host must be one printable word not starting with '-'")
    return text


def _read_text(path) -> str:
    try:
        return Path(path).read_text(errors="replace").strip()
    except OSError:
        return ""


_FQDN = None


def fqdn_once() -> str:
    """socket.getfqdn() does a reverse lookup that blocks for 5s on a host
    whose name does not resolve, and this probe runs every couple of seconds.
    Ask at most once per process, and only after the cheap names have missed."""
    global _FQDN
    if _FQDN is None:
        try:
            _FQDN = socket.getfqdn().strip().rstrip(".").lower()
        except OSError:
            _FQDN = ""
    return _FQDN


def is_local_host(host: str) -> bool:
    """True when --host is this machine, so telemetry must not go over ssh.

    Must answer exactly as burnbar-collect.is_local_host does, or the lane
    discovers a GPU here and then tries to read its journal over ssh."""
    name = str(host or "").strip().split("@")[-1].rstrip(".").lower()
    if not name or name in ("localhost", "127.0.0.1", "::1"):
        return True
    try:
        short = socket.gethostname().strip().rstrip(".").lower()
    except OSError:
        return False
    if name == short or name == short.split(".")[0]:
        return True
    return bool(name) and name == fqdn_once()


def pci_compute_gpus(sys_pci=None) -> list:
    """Display/3D adapters whose vendor is NVIDIA or AMD. Intel iGPUs skip."""
    root = Path(sys_pci) if sys_pci else Path("/sys/bus/pci/devices")
    found = []
    if not root.is_dir():
        return found
    try:
        devices = list(root.iterdir())
    except OSError:
        return found
    for dev in devices:
        cls = _read_text(dev / "class").lower()
        if not cls.startswith("0x03"):
            continue
        vendor = _read_text(dev / "vendor").lower()
        kind = COMPUTE_GPU_VENDORS.get(vendor)
        if not kind:
            continue
        found.append({"vendor": kind, "class": cls, "id": dev.name})
    return found


def nvidia_smi_gpus() -> list:
    """Names from `nvidia-smi -L`, or empty when the tool is missing/useless."""
    if not shutil.which("nvidia-smi"):
        return []
    try:
        run = subprocess.run(["nvidia-smi", "-L"], capture_output=True, text=True, timeout=4)
    except (OSError, subprocess.SubprocessError):
        return []
    if run.returncode != 0:
        return []
    names = []
    for line in run.stdout.splitlines():
        line = line.strip()
        if not line.lower().startswith("gpu "):
            continue
        # GPU 0: NVIDIA GeForce RTX 4090 (UUID: ...)
        name = line.split(":", 1)[-1]
        name = name.split("(UUID", 1)[0].strip()
        if name and "[N/A]" not in name:
            names.append(bounded_text(name, 64))
    return names


def this_machine_gpu() -> dict:
    """A compute GPU on *this* box. Intel iGPU is not one."""
    if Path("/etc/nv_tegra_release").exists():
        name = _read_text("/proc/device-tree/model").replace("\x00", "")
        for noise in ("NVIDIA ", " Engineering Reference Developer Kit"):
            name = name.replace(noise, "")
        return {"hasGpu": True, "gpuName": bounded_text(name or "Jetson", 64),
                "backend": "tegra", "where": "local", "reason": ""}
    names = nvidia_smi_gpus()
    if names:
        return {"hasGpu": True, "gpuName": names[0], "backend": "nvidia",
                "where": "local", "reason": ""}
    pci = pci_compute_gpus()
    if pci:
        kind = pci[0]["vendor"]
        return {"hasGpu": True, "gpuName": kind, "backend": kind.lower(),
                "where": "local", "reason": ""}
    return {"hasGpu": False, "gpuName": "", "backend": "none",
            "where": "none", "reason": "no discrete GPU"}


def probe_remote_gpu(host: str) -> dict:
    """One cheap ssh: is there a Jetson or nvidia-smi on that box?"""
    try:
        dest = ssh_host(host)
    except ValueError as error:
        return {"hasGpu": False, "gpuName": "", "backend": "none",
                "where": "none", "reason": bounded_text(error, MAX_ERROR_LENGTH)}
    snippet = (
        "if [ -f /etc/nv_tegra_release ]; then echo tegra; "
        "tr -d '\\0' < /proc/device-tree/model 2>/dev/null; "
        "elif command -v nvidia-smi >/dev/null 2>&1; then echo nvidia; "
        "nvidia-smi -L 2>/dev/null | head -1; "
        "else echo none; fi"
    )
    command = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3",
               "-o", "LogLevel=ERROR", "--", dest, "sh", "-c", snippet]
    try:
        run = subprocess.run(command, capture_output=True, text=True, timeout=8)
    except FileNotFoundError:
        return {"hasGpu": False, "gpuName": "", "backend": "none",
                "where": "none", "reason": "ssh not found"}
    except subprocess.SubprocessError as error:
        return {"hasGpu": False, "gpuName": "", "backend": "none",
                "where": "none", "reason": bounded_text("ssh %s: %s" % (dest, error), MAX_ERROR_LENGTH)}
    if run.returncode != 0:
        reason = (run.stderr.strip().splitlines() or ["ssh exited %d" % run.returncode])[-1]
        return {"hasGpu": False, "gpuName": "", "backend": "none",
                "where": "none", "reason": bounded_text("ssh %s: %s" % (dest, reason), MAX_ERROR_LENGTH)}
    lines = [ln.strip() for ln in run.stdout.splitlines() if ln.strip()]
    kind = lines[0].lower() if lines else "none"
    name = " ".join(lines[1:]) if len(lines) > 1 else ""
    if kind == "tegra":
        for noise in ("NVIDIA ", " Engineering Reference Developer Kit"):
            name = name.replace(noise, "")
        return {"hasGpu": True, "gpuName": bounded_text(name or "Jetson", 64),
                "backend": "tegra", "where": "remote", "reason": ""}
    if kind == "nvidia":
        if ":" in name:
            name = name.split(":", 1)[-1]
        name = name.split("(UUID", 1)[0].strip()
        return {"hasGpu": True, "gpuName": bounded_text(name or "NVIDIA", 64),
                "backend": "nvidia", "where": "remote", "reason": ""}
    return {"hasGpu": False, "gpuName": "", "backend": "none",
            "where": "none", "reason": "no discrete GPU on %s" % dest}


def discover_gpu(host: str) -> dict:
    """Compute GPU on *this* machine only. A Jetson down the hall is not
    this laptop's GPU; Intel iGPU is not one either."""
    return this_machine_gpu()


def reject_nonfinite(value: str):
    raise ValueError(f"non-finite JSON number: {value}")


def parse_finite_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed):
        reject_nonfinite(value)
    return parsed


def read_json_response(response) -> dict:
    raw = response.read(MAX_HTTP_RESPONSE_BYTES + 1)
    if len(raw) > MAX_HTTP_RESPONSE_BYTES:
        raise ValueError("Ollama response exceeds 1 MiB")
    payload = json.loads(raw.decode("utf-8"), parse_constant=reject_nonfinite,
                         parse_float=parse_finite_float)
    if not isinstance(payload, dict):
        raise ValueError("Ollama response must be a JSON object")
    return payload


def bounded_int(value, limit: int = 10**16) -> int:
    # Integers are clamped as integers: math.isfinite() converts to float
    # first, and a 400-digit JSON integer raised OverflowError there.
    if isinstance(value, bool):
        return 0
    if isinstance(value, int):
        return int(min(max(value, 0), limit))
    if isinstance(value, float) and math.isfinite(value):
        return int(min(max(value, 0), limit))
    return 0


def ollama_models(url: str) -> list[dict]:
    """Resident models with everything /api/ps knows about them: memory
    footprint, context length, quantisation and the keep-alive deadline. All
    bounded: this is the one place untrusted JSON turns into panel text."""
    with urllib.request.urlopen(normalize_url(url) + "/api/ps", timeout=HTTP_TIMEOUT) as response:
        payload = read_json_response(response)
    models = payload.get("models", [])
    if not isinstance(models, list):
        return []
    safe_models = []
    for model in models[:MAX_MODELS]:
        if not isinstance(model, dict):
            continue
        name = bounded_text(model.get("name") or model.get("model"))
        if not name:
            continue
        details = model.get("details")
        details = details if isinstance(details, dict) else {}
        safe_models.append({
            "name": name,
            "size": bounded_int(model.get("size")),
            "sizeVram": bounded_int(model.get("size_vram")),
            "contextLength": bounded_int(model.get("context_length"), 10**9),
            "expiresAt": bounded_text(model.get("expires_at"), 64),
            "parameters": bounded_text(details.get("parameter_size"), 32),
            "quantization": bounded_text(details.get("quantization_level"), 32),
            "family": bounded_text(details.get("family"), 32),
        })
    return safe_models


def ollama_version(url: str) -> str:
    try:
        with urllib.request.urlopen(normalize_url(url) + "/api/version", timeout=HTTP_TIMEOUT) as response:
            payload = read_json_response(response)
        return bounded_text(payload.get("version"), 32)
    except (OSError, urllib.error.URLError, json.JSONDecodeError, UnicodeDecodeError, ValueError):
        return ""


def num(text, scale=1.0, limit=10**12) -> float:
    try:
        value = float(str(text).strip()) * scale
    except (TypeError, ValueError):
        return 0.0
    return value if math.isfinite(value) and 0 <= value <= limit else 0.0


def parse_telemetry(text: str) -> dict:
    """The snippet's lines into panel fields. Anything missing reads as 0,
    which the panel shows as "--" with the bar hidden."""
    fields = {}
    rails = {}
    for line in text.splitlines():
        parts = line.split()
        if not parts:
            continue
        key, values = parts[0], parts[1:]
        if key == "cpu_ticks" and len(values) == 2:
            mine, everyone = num(values[0]), num(values[1])
            fields["cpu"] = round(min(100.0, mine / everyone * 100.0), 1) if everyone > 0 else 0.0
        elif key == "gpu_load" and values:
            fields["gpu"] = round(min(100.0, num(values[0]) / 10.0), 1)
        elif key == "gpu_hz" and len(values) == 2:
            fields["clockMhz"] = round(num(values[0], 1e-6))
            fields["clockMaxMhz"] = round(num(values[1], 1e-6))
        elif key == "temp_gpu" and values:
            fields["tempC"] = round(num(values[0], 1e-3))
        elif key.startswith("rail_") and len(values) == 2:
            rails[key[5:]] = num(values[0]) * num(values[1]) / 1e6   # mV × mA → W
        elif key == "fan_pwm" and values:
            fields["fanPct"] = round(min(100.0, num(values[0]) / 255.0 * 100.0))
        elif key == "mem" and len(values) == 2:
            total, available = num(values[0]), num(values[1])
            fields["vramTotalMb"] = round(total / 1024)
            fields["vramUsedMb"] = round(max(0.0, total - available) / 1024)
        elif key == "model":
            name = " ".join(values)
            for noise in ("NVIDIA ", " Engineering Reference Developer Kit"):
                name = name.replace(noise, "")
            fields["gpuName"] = bounded_text(name, 64)
    # VDD_IN is the whole board at the barrel jack: what the power tile has
    # always meant. The CPU/GPU/CV rail is the part inference moves.
    if "VDD_IN" in rails:
        fields["powerW"] = round(rails["VDD_IN"], 1)
    if "VDD_CPU_GPU_CV" in rails:
        fields["gpuRailW"] = round(rails["VDD_CPU_GPU_CV"], 1)
    return fields


def local_ollama_cpu() -> float:
    """Share of CPU used by processes named ollama, sampled 200 ms apart."""
    snippet = r'''
ticks() { t=0; for p in /proc/[0-9]*; do [ "$(cat $p/comm 2>/dev/null)" = ollama ] || continue; set -- $(cat $p/stat 2>/dev/null); t=$((t + ${14:-0} + ${15:-0})); done; echo $t; }
total() { set -- $(grep "^cpu " /proc/stat); echo $(($2+$3+$4+$5+$6+$7+$8)); }
t1=$(ticks); c1=$(total); sleep 0.2; t2=$(ticks); c2=$(total)
echo "cpu_ticks $((t2-t1)) $((c2-c1))"
'''
    try:
        run = subprocess.run(["sh", "-c", snippet], capture_output=True, text=True, timeout=4)
    except (OSError, subprocess.SubprocessError):
        return 0.0
    fields = parse_telemetry(run.stdout)
    return float(fields.get("cpu") or 0.0)


def nvidia_telemetry() -> tuple[dict, str]:
    """nvidia-smi on this machine. [N/A] fields (typical on a Jetson) are 0."""
    if not shutil.which("nvidia-smi"):
        return {}, "nvidia-smi not found"
    query = ("name,utilization.gpu,memory.used,memory.total,temperature.gpu,"
             "power.draw,power.limit,clocks.sm,clocks.max.sm,fan.speed")
    command = ["nvidia-smi", "--query-gpu=" + query, "--format=csv,noheader,nounits"]
    try:
        run = subprocess.run(command, capture_output=True, text=True, timeout=4)
    except (OSError, subprocess.SubprocessError) as error:
        return {}, bounded_text(error, MAX_ERROR_LENGTH)
    if run.returncode != 0:
        reason = (run.stderr.strip().splitlines() or ["nvidia-smi exited %d" % run.returncode])[-1]
        return {}, bounded_text(reason, MAX_ERROR_LENGTH)
    line = ""
    for raw in run.stdout.splitlines():
        if raw.strip():
            line = raw
            break
    if not line:
        return {}, "nvidia-smi listed no GPUs"
    parts = [p.strip() for p in line.split(",")]
    if len(parts) < 10:
        return {}, "nvidia-smi output was short"
    def smi_num(text, scale=1.0):
        t = str(text).strip()
        if t in ("[N/A]", "N/A", "Not Supported", ""):
            return 0.0
        return num(t, scale)
    name = parts[0]
    if name in ("[N/A]", "N/A", ""):
        name = "NVIDIA"
    fields = {
        "gpuName": bounded_text(name, 64),
        "gpu": round(min(100.0, smi_num(parts[1])), 1),
        "vramUsedMb": round(smi_num(parts[2])),
        "vramTotalMb": round(smi_num(parts[3])),
        "tempC": round(smi_num(parts[4])),
        "powerW": round(smi_num(parts[5]), 1),
        "powerLimitW": round(smi_num(parts[6]), 1),
        "clockMhz": round(smi_num(parts[7])),
        "clockMaxMhz": round(smi_num(parts[8])),
        "fanPct": round(min(100.0, smi_num(parts[9]))),
        "cpu": local_ollama_cpu(),
    }
    return fields, ""


def amd_telemetry(sys_drm=None) -> tuple[dict, str]:
    """Read local amdgpu counters without NVIDIA tools or privileged writes.

    GPU busy is device-wide, including desktop rendering. main() only calls
    it inference activity when a model is resident. Dedicated VRAM counters
    are omitted: an integrated GPU also uses shared system memory, and those
    counters would misrepresent the model's usable memory budget.
    """
    root = Path(sys_drm) if sys_drm else Path("/sys/class/drm")
    try:
        cards = sorted(root.glob("card[0-9]*"))
    except OSError:
        cards = []
    for card in cards:
        if not card.name[4:].isdigit():
            continue
        device = card / "device"
        if _read_text(device / "vendor").lower() != "0x1002":
            continue
        fields = {"gpuName": "AMD", "cpu": local_ollama_cpu()}

        def reading(path, key, scale=1.0, limit=None):
            raw = _read_text(path)
            try:
                value = float(raw) * scale
            except (TypeError, ValueError):
                return
            if not math.isfinite(value) or value < 0:
                return
            fields[key] = round(min(value, limit) if limit is not None else value, 1)

        reading(device / "gpu_busy_percent", "gpu", limit=100.0)
        try:
            monitors = sorted((device / "hwmon").glob("hwmon*"))
        except OSError:
            monitors = []
        for monitor in monitors:
            if _read_text(monitor / "name") != "amdgpu":
                continue
            reading(monitor / "temp1_input", "tempC", 0.001)
            reading(monitor / "freq1_input", "clockMhz", 0.000001)
            reading(monitor / "power1_average", "powerW", 0.000001)
            reading(monitor / "power1_cap", "powerLimitW", 0.000001)
            break
        return fields, "" if "gpu" in fields else "AMD GPU load counter unavailable"
    return {}, "AMD DRM device not found"


def tegra_telemetry_local() -> tuple[dict, str]:
    try:
        run = subprocess.run(["sh", "-c", TELEMETRY_SNIPPET], capture_output=True, text=True, timeout=SSH_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as error:
        return {}, bounded_text(error, MAX_ERROR_LENGTH)
    if run.returncode != 0:
        reason = (run.stderr.strip().splitlines() or ["tegra snippet exited %d" % run.returncode])[-1]
        return {}, bounded_text(reason, MAX_ERROR_LENGTH)
    fields = parse_telemetry(run.stdout)
    if "gpu" not in fields:
        return fields, "no GPU load reading"
    return fields, ""


def telemetry_ssh(host: str) -> tuple[dict, str]:
    """(fields, error). BatchMode so a missing key fails now rather than
    prompting a process nobody can see; the ConnectTimeout bounds a box that
    is off, and the subprocess timeout bounds one that answers and stalls."""
    command = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "-o", "ServerAliveInterval=3",
               "-o", "LogLevel=ERROR", "--", host, "sh", "-c", TELEMETRY_SNIPPET]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=SSH_TIMEOUT, check=False)
    except FileNotFoundError:
        return {}, "ssh not found"
    except subprocess.SubprocessError as error:
        return {}, bounded_text("ssh %s: %s" % (host, error), MAX_ERROR_LENGTH)
    if result.returncode != 0:
        reason = (result.stderr.strip().splitlines() or ["ssh exited %d" % result.returncode])[-1]
        return {}, bounded_text("ssh %s: %s" % (host, reason), MAX_ERROR_LENGTH)
    fields = parse_telemetry(result.stdout)
    if "gpu" not in fields:
        return fields, "no GPU load reading from %s" % host
    return fields, ""


def telemetry(host: str, gpu_info=None) -> tuple[dict, str]:
    """Hardware figures for the Ollama box. Local NVIDIA/Jetson never ssh."""
    info = gpu_info if isinstance(gpu_info, dict) else this_machine_gpu()
    if is_local_host(host):
        backend = info.get("backend") or ""
        if backend == "nvidia":
            return nvidia_telemetry()
        if backend == "tegra":
            return tegra_telemetry_local()
        if backend == "amd":
            return amd_telemetry()
        return {}, info.get("reason") or "no discrete GPU"
    return telemetry_ssh(host)


# Keep the old name so existing unit tests that patch telemetry() still hit
# the ssh path they were written against.
def telemetry_remote(host: str) -> tuple[dict, str]:
    return telemetry_ssh(host)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--threshold", type=float, default=8.0)
    parser.add_argument("--url", default=os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434"))
    parser.add_argument("--host", default=os.environ.get("BURNBAR_LOCAL_HOST", "localhost"))
    parser.add_argument("--discover", action="store_true",
                        help="Print whether a compute GPU exists and exit. No Ollama call.")
    args = parser.parse_args()
    try:
        host = ssh_host(args.host)
    except ValueError as error:
        print(json.dumps({"hasGpu": False, "online": False, "active": False, "load": 0,
                          "modelCount": 0, "model": "", "backend": "none",
                          "error": bounded_text(error, MAX_ERROR_LENGTH)}))
        return 0

    gpu_info = discover_gpu(host)
    if args.discover:
        print(json.dumps(gpu_info))
        return 0

    if not gpu_info.get("hasGpu"):
        print(json.dumps({"online": False, "active": False, "load": 0, "modelCount": 0,
                          "model": "", "backend": "none", "hasGpu": False,
                          "host": host, "where": gpu_info.get("where") or "none",
                          "error": gpu_info.get("reason") or "no discrete GPU"}))
        return 0

    try:
        models = ollama_models(args.url)
    except (OSError, urllib.error.URLError, json.JSONDecodeError, UnicodeDecodeError, ValueError) as error:
        print(json.dumps({"online": False, "active": False, "load": 0, "modelCount": 0,
                          "model": "", "backend": gpu_info.get("backend") or "none",
                          "hasGpu": True, "gpuName": gpu_info.get("gpuName") or "",
                          "host": host, "where": gpu_info.get("where") or "none",
                          "error": bounded_text(error, MAX_ERROR_LENGTH)}))
        return 0

    names = [model["name"] for model in models]
    fields, telemetry_error = telemetry(host, gpu_info)
    gpu = fields.get("gpu", 0.0)
    cpu = fields.get("cpu", 0.0)
    # Device-wide GPU utilisation belongs to whatever is using the GPU. With
    # no model resident none of it is inference: the lane then reads the
    # runner's own CPU only, and "active" needs a resident model.
    load = round(max(cpu, gpu) if models else cpu, 1)
    backend = gpu_info.get("backend") or ("nvidia" if fields.get("gpuName") else "tegra")
    payload = {"online": True, "active": bool(models) and load >= args.threshold,
               "load": load, "remote": not is_local_host(host), "host": host,
               "hasGpu": True, "where": gpu_info.get("where") or "none",
               "modelCount": len(models), "model": names[0] if names else "",
               "models": names, "modelDetails": models, "backend": backend,
               "cpu": round(cpu, 1), "gpu": round(gpu, 1),
               "version": ollama_version(args.url),
               "vramModelsMb": round(sum(m["sizeVram"] for m in models) / 1048576),
               "telemetryError": telemetry_error}
    payload.update({k: v for k, v in fields.items() if k not in ("gpu", "cpu")})
    if not payload.get("gpuName"):
        payload["gpuName"] = gpu_info.get("gpuName") or ""
    print(json.dumps(payload))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
