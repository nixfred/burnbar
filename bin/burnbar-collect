#!/usr/bin/env python3
"""burnbar-collect: buckets Claude + Codex + Grok token burn into a rolling window.

Reads the raw agent transcripts (the only place per-turn token deltas carry
timestamps) and writes one small JSON the QML widget watches.

Python 3 with no third-party imports on purpose: Omarchy depends on uwsm and
kitty, both of which depend on python, so python3 is present on every Omarchy
install. bun is not an Omarchy dependency and cannot be assumed.

State lives under XDG_STATE_HOME, never inside the plugin directory: a plugin
writing in its own dir makes Omarchy rebuild every plugin service.

Claude:  ~/.claude/projects/**/*.jsonl   assistant lines carry message.usage.
         The same assistant message is re-serialized up to 3x as it streams,
         each revision with more output than the last, so message.id is a
         mandatory dedupe key and the LARGEST revision is the one that counts.
Codex:   ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl   event_msg lines with
         payload.type == "token_count" carry info.total_token_usage, a
         cumulative counter for the session. Deltas of that counter are what
         gets counted: a rate-limit refresh re-emits the same last_token_usage
         with an unchanged total (13 times across 130 rollouts on the machine
         this was built on), and counting last_token_usage would count it twice.

Grok:    ~/.grok/sessions/**/updates.jsonl   _meta.totalTokens is the running
         context size for a promptId (Grok Bot / Build sessions, the local
         transcript store beside the Grok Bot app process).
         Per-prompt burn is estimated as
         max(totalTokens)-min(totalTokens) within that prompt; flat prompts
         contribute nothing. Plan limits come from the latest
         "billing: fetched credits config" line in ~/.grok/logs/unified.jsonl
         (same source pi.agents uses), falling back to agents/usage/grok.json.

Local:   the ollama-meter journal on the box that runs Ollama (nano, a
         Jetson), read over ssh. Ollama persists no per-request token counts
         anywhere, so nano/ollama-meter.py sits in front of it and writes
         one line per request with the counts off the response. Read by
         journal cursor: one ssh round trip (~250 ms) per run, and only the
         lines since last time.
         Local work that never reaches Ollama (local-ai on TabbyAPI, an NPU
         embedder) is read from local-usage.jsonl beside history.json, where
         the callers append one line per request.

Two clocks. The strip and chart use grid-aligned buckets so cells march instead
of jittering; every headline number (totals, rates, turns, activity, split,
by-model) is computed over the exact trailing window from the timestamped
points, so "last 6h" means the last 360 minutes and "1 HOUR" means 60.
"""

import datetime
import fcntl
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state")
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
# Omarchy's Claude collector keeps its last *successful* limits probe here.
PROBE_CACHE_DIR = CACHE / "omarchy" / "agent-usage"
OUT_DIR = STATE / "omarchy" / "burnbar"
OUT_FILE = OUT_DIR / "history.json"
CACHE_FILE = OUT_DIR / "scan-cache.json"
LOCK_FILE = OUT_DIR / "collect.lock"
USAGE_DIR = STATE / "omarchy" / "agents" / "usage"

CLAUDE_ROOT = HOME / ".claude" / "projects"
CODEX_ROOT = HOME / ".codex" / "sessions"
# Zcode (Z.ai's coding agent) keeps one model-io jsonl per session under
# ~/.zcode/cli/rollout; each line is one completed model request with its own
# usage object and the model id that served it. The older agents/* transcript
# store is a different shape and is not read: the rollout store is the
# lane's root.
ZCODE_ROOT = HOME / ".zcode" / "cli" / "rollout"
GROK_HOME = Path(os.environ.get("GROK_HOME") or HOME / ".grok")
GROK_ROOT = GROK_HOME / "sessions"
GROK_LOG = GROK_HOME / "logs" / "unified.jsonl"

CACHE_VERSION = 2
# A token count larger than this is not a token count.
MAX_TOKENS = 10**12
# The longest supported window is 24h; cached points older than this can never
# be asked for again and would otherwise accumulate for the life of a session.
PRUNE_MS = 25 * 3600 * 1000
# Bytes of transcript remembered just before the saved offset. A resume is only
# trusted when those bytes still read the same: a rewrite that happens to be
# longer than the cached file is not an append.
TAIL_BYTES = 48
# Records stamped further ahead of now than this are clock skew, not data.
FUTURE_SLACK_MS = 60_000


def int_arg(flag, fallback, low, high):
    argv = sys.argv
    if flag in argv:
        i = argv.index(flag)
        if i + 1 < len(argv):
            try:
                return max(low, min(high, int(argv[i + 1])))
            except ValueError:
                pass
    return fallback


def str_arg(flag, fallback, limit=64):
    argv = sys.argv
    if flag in argv:
        i = argv.index(flag)
        if i + 1 < len(argv) and argv[i + 1].strip():
            return argv[i + 1].strip()[:limit]
    return fallback


USAGE = """burnbar-collect: bucket Claude, Codex, Grok and Zcode token burn into a rolling window.

usage: burnbar-collect [--window MIN] [--buckets N] [--no-local]
                       [--meter-host HOST] [--meter-unit UNIT] [--print]

  --window MIN       minutes the strip reaches back (30..1440, default 360)
  --buckets N        cells per cloud agent (6..240, default 12)
  --no-local         skip the local lane and its ssh/HTTP probes entirely
  --meter-host HOST  ssh alias of the Ollama box, or localhost (default localhost)
  --meter-unit UNIT  systemd unit whose journal carries one line per request
                     (default ollama-meter)
  --print            also print the payload to stdout after writing it
  -h, --help         show this and exit without collecting

Writes history.json under $XDG_STATE_HOME/omarchy/burnbar. Out-of-range numbers
clamp to the bounds above; an unrecognised flag is ignored rather than fatal,
because a collector that exits leaves the widget with an empty strip.

environment: BURNBAR_LOCAL_HOST, BURNBAR_METER_UNIT, BURNBAR_NO_LOCAL=1,
             BURNBAR_LOCAL_LEDGER, GROK_HOME, BURNBAR_NOW_MS (tests pin the clock)
"""

# Before any argument is read or any state directory is touched, so that asking
# for help never collects.
if {"-h", "--help"} & set(sys.argv[1:]):
    print(USAGE, end="")
    sys.exit(0)


WINDOW_MIN = int_arg("--window", 360, 30, 1440)
BUCKETS = int_arg("--buckets", 12, 6, 240)
BUCKET_MS = round(WINDOW_MIN * 60_000 / BUCKETS)
METER_HOST = str_arg("--meter-host", os.environ.get("BURNBAR_LOCAL_HOST") or "localhost", 128)
METER_UNIT = str_arg("--meter-unit", os.environ.get("BURNBAR_METER_UNIT") or "ollama-meter")
# Service passes --no-local when no compute GPU was found, so a GPU-less
# laptop never ssh's to a host named nano that does not exist.
NO_LOCAL = "--no-local" in sys.argv or os.environ.get("BURNBAR_NO_LOCAL") == "1"

# Tests pin the clock so two runs can be compared byte for byte across a bucket
# boundary; nothing else sets it.
try:
    now_ms = int(os.environ["BURNBAR_NOW_MS"])
except (KeyError, ValueError):
    now_ms = int(time.time() * 1000)

# Anchor the strip to the bucket grid so cells march instead of jittering. The
# grid holds BUCKETS-1 whole buckets plus the partial newest one, so it covers
# a little less than the window, which is why the headline numbers below use
# the exact window instead.
grid_now = (now_ms // BUCKET_MS) * BUCKET_MS
grid_start = grid_now - (BUCKETS - 1) * BUCKET_MS
exact_start = now_ms - WINDOW_MIN * 60_000
scan_floor = min(grid_start, exact_start)
latest_ok = now_ms + FUTURE_SLACK_MS
t5 = now_ms - 5 * 60_000
t60 = now_ms - 60 * 60_000

buckets = [{"t": grid_start + i * BUCKET_MS, "claude": 0, "codex": 0, "grok": 0, "kimi": 0,
            "zcode": 0, "local": 0}
           for i in range(BUCKETS)]


def bucket_for(ts):
    if ts < grid_start or ts > latest_ok:
        return None
    idx = (ts - grid_start) // BUCKET_MS
    return buckets[idx] if 0 <= idx < BUCKETS else None


def in_window(ts):
    return exact_start <= ts <= latest_ok


def parse_ts(value):
    """ISO-8601 with a trailing Z, as both agents emit. Returns epoch ms."""
    if not value:
        return None
    try:
        text = str(value).replace("Z", "+00:00")
        return int(datetime.datetime.fromisoformat(text).timestamp() * 1000)
    except Exception:
        return None


def count(value):
    """A token count: a non-negative bounded integer. None for anything else,
    a bool, a string, a negative, a float that is not whole, 1e999."""
    if value is None:
        return 0
    if isinstance(value, bool):
        return None
    if isinstance(value, float):
        if value != value or value in (float("inf"), float("-inf")) or not value.is_integer():
            return None
        value = int(value)
    if not isinstance(value, int):
        return None
    if value < 0 or value > MAX_TOKENS:
        return None
    return value


# ── incremental scan cache ───────────────────────────────────────────────────
# Transcripts are append-only, so a file whose size and mtime are unchanged
# contributes exactly what it contributed last run, and a file that merely grew
# is read from the previous byte offset. Every entry is validated before it is
# believed: a malformed one is a cache miss, never a crash that repeats forever.
def load_cache():
    try:
        raw = json.loads(CACHE_FILE.read_text()) if CACHE_FILE.exists() else {}
    except Exception:
        return {}
    if not isinstance(raw, dict) or raw.get("v") != CACHE_VERSION:
        return {}
    files = raw.get("files")
    return files if isinstance(files, dict) else {}


cache = load_cache()
next_cache = {}


def valid_point(pt):
    return (isinstance(pt, list) and len(pt) >= 2
            and isinstance(pt[0], int) and not isinstance(pt[0], bool)
            and isinstance(pt[1], int) and not isinstance(pt[1], bool)
            and pt[1] >= 0)


def valid_entry(hit):
    if not isinstance(hit, dict):
        return None
    size, mtime, offset = hit.get("size"), hit.get("mtime"), hit.get("offset")
    if not (isinstance(size, int) and not isinstance(size, bool) and size >= 0):
        return None
    if not isinstance(mtime, (int, float)) or isinstance(mtime, bool):
        return None
    if not (isinstance(offset, int) and not isinstance(offset, bool) and 0 <= offset <= size):
        return None
    points = hit.get("points")
    if not isinstance(points, list) or not all(valid_point(p) for p in points):
        return None
    if not isinstance(hit.get("tail", ""), str):
        return None
    state = hit.get("state", {})
    if not isinstance(state, dict):
        return None
    return hit


def prune(points):
    floor = now_ms - PRUNE_MS
    return [p for p in points if p[0] >= floor]


def read_tail(path, offset):
    start = max(0, offset - TAIL_BYTES)
    with path.open("rb") as fh:
        fh.seek(start)
        return fh.read(offset - start).hex()


def _scan(path, extract, use_cache):
    try:
        st = path.stat()
    except OSError:
        return []
    # A file untouched since the window opened cannot hold points inside it.
    if st.st_mtime * 1000 < scan_floor:
        return []

    key = str(path)
    hit = valid_entry(cache.get(key)) if use_cache else None
    if hit and hit["size"] == st.st_size and hit["mtime"] == st.st_mtime:
        hit = dict(hit, points=prune(hit["points"]))
        next_cache[key] = hit
        return hit["points"]

    # Resume only when the file strictly grew AND the bytes just before the
    # saved offset still read the same. A shrink, an equal size with a new
    # mtime, or a longer rewrite are all rewrites; the cached offset is
    # meaningless and the whole file is read again.
    start = 0
    points = []
    state = {}
    if hit and st.st_size > hit["size"] and hit["offset"] <= st.st_size:
        try:
            same = read_tail(path, hit["offset"]) == hit.get("tail", "")
        except OSError:
            same = False
        if same:
            start = hit["offset"]
            points = list(hit["points"])
            state = dict(hit.get("state") or {})

    offset = start
    try:
        with path.open("rb") as fh:
            fh.seek(start)
            data = fh.read()
    except OSError:
        return []

    # Stop at the last newline: a trailing fragment is a half-written record,
    # and consuming it would both drop the record and desync the offset.
    cut = data.rfind(b"\n")
    if cut != -1:
        offset = start + cut + 1
        for raw in data[:cut].split(b"\n"):
            if not raw:
                continue
            pt = extract(raw.decode("utf-8", "replace"), state)
            if pt:
                points.append(pt)

    points = prune(points)
    try:
        tail = read_tail(path, offset)
    except OSError:
        tail = ""
    next_cache[key] = {"size": st.st_size, "mtime": st.st_mtime, "offset": offset,
                       "tail": tail, "points": points, "state": state}
    return points


def scan(path, extract):
    """Every point in `path`, re-parsing as little as possible. A cached entry
    that turns out to be unusable is dropped and the file read from scratch;
    a file that cannot be read at all contributes nothing and is not cached."""
    try:
        return _scan(path, extract, use_cache=True)
    except Exception:
        next_cache.pop(str(path), None)
        try:
            return _scan(path, extract, use_cache=False)
        except Exception:
            next_cache.pop(str(path), None)
            return []


# Both extractors treat a record as untrusted end to end. Valid JSON with the
# wrong shape ("input_tokens": "unknown", "info": "bad"), a number that only
# fits a float (1e999 → OverflowError on int()), a negative count, a bool,
# any of them used to abort the whole collection for both agents, and the
# same record would do it again on every run. Now the record is skipped.
MALFORMED = (TypeError, ValueError, AttributeError, KeyError, OverflowError)


def claude_extract(line, _state):
    if "usage" not in line:
        return None
    try:
        d = json.loads(line)
        msg = d.get("message") or {}
        usage = msg.get("usage")
        if not isinstance(usage, dict):
            return None
        ts = parse_ts(d.get("timestamp"))
        if ts is None:
            return None
        parts = [count(usage.get("input_tokens")),
                 count(usage.get("cache_creation_input_tokens")),
                 count(usage.get("output_tokens")),
                 count(usage.get("cache_read_input_tokens"))]
        if any(p is None for p in parts):
            return None
        inp, cache_w, out, cache_r = parts
        # A record that only read cache still happened: it is a turn, and the
        # panel's cache-read line wants it. It just adds nothing to the heat.
        if inp + cache_w + out + cache_r == 0:
            return None
        # Billable work: fresh input + what we paid to write cache + output.
        # Cache reads are excluded on purpose; they are the cheap path and
        # would swamp the scale (939M read vs 24M written on the machine this
        # was built on).
        tokens = inp + cache_w + out
        return [ts, tokens, str(msg.get("id") or "")[:64], str(msg.get("model") or "unknown")[:64],
                [inp, cache_w, out, cache_r]]
    except MALFORMED:
        return None


def codex_usage(block):
    """(input-minus-cached, cache_write, output, cached) from a Codex usage
    block, or None if any field is not a sane count."""
    if not isinstance(block, dict):
        return None
    parts = [count(block.get("input_tokens")), count(block.get("cached_input_tokens")),
             count(block.get("cache_write_input_tokens")), count(block.get("output_tokens"))]
    if any(p is None for p in parts):
        return None
    inp, cached, cache_w, out = parts
    if cached > inp:
        return None
    return [inp - cached, cache_w, out, cached]


def codex_extract(line, state):
    if "token_count" not in line:
        return None
    try:
        d = json.loads(line)
        payload = d.get("payload") or {}
        if payload.get("type") != "token_count":
            return None
        info = payload.get("info") or {}
        ts = parse_ts(d.get("timestamp"))
        if ts is None:
            return None
        total = codex_usage(info.get("total_token_usage"))
        last = codex_usage(info.get("last_token_usage"))
        split = None
        if total is not None:
            prev = state.get("cum")
            state["cum"] = total
            if isinstance(prev, list) and len(prev) == 4:
                delta = [total[i] - prev[i] for i in range(4)]
                if all(x == 0 for x in delta):
                    # The same snapshot again, a rate-limit refresh. Not a turn.
                    return None
                if all(x >= 0 for x in delta):
                    split = delta
                # A counter that went backwards is a session reset: fall through
                # and take this event's own usage as the delta.
        if split is None:
            split = last
        if split is None or sum(split) == 0:
            return None
        return [ts, split[0] + split[1] + split[2], "", "codex", split]
    except MALFORMED:
        return None


def walk(root, match):
    if not root.is_dir():
        return
    # followlinks: a session store symlinked onto another disk is a real
    # layout, and os.walk skips those by default; every transcript under one
    # would go missing with nothing said about it. The visited set is what
    # keeps a symlink cycle from walking forever.
    seen = set()
    for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
        try:
            info = os.stat(dirpath)
            key = (info.st_dev, info.st_ino)
        except OSError:
            dirnames[:] = []
            continue
        if key in seen:
            dirnames[:] = []
            continue
        seen.add(key)
        for name in filenames:
            if match(name):
                yield Path(dirpath) / name


def usable_zcode_id(rid):
    return (isinstance(rid, str) and bool(rid.strip())
            and not any(ord(c) < 32 or ord(c) == 127 for c in rid))


def zcode_extract(line, state):
    """One line of a zcode model-io rollout: a completed model request with
    its own usage. Per-request counts, so there is no cumulative counter to
    difference (the Codex problem) and no streamed revisions to dedupe (the
    Claude problem); requestId is kept in the point so a re-read of a
    rewritten file cannot count a request twice. zcode's inputTokens is a
    bundle: input plus cache write plus cache read (its own agent builds it
    that way, and on real rollouts it equals the provider's input_tokens plus
    cache_read), so the fresh input is what remains after both are taken
    back out, and the heat counts fresh + cache write + output with cache
    reads carried in the split only, as with every other lane. A usage field
    that is present but not a count rejects the line; a field that is simply
    absent reads as zero, because zcode lines carry no cache fields at all
    when the provider had none to report."""
    if '"usage"' not in line:
        return None
    try:
        d = json.loads(line)
        # The usage object rides inside the recorded response, not at the top
        # level: response.usage is zcode's own shape, and providers that
        # report through response.providerMetadata duplicate it there.
        response = d.get("response")
        usage = response.get("usage") if isinstance(response, dict) else None
        if not isinstance(usage, dict):
            return None
        ts = parse_ts(d.get("completedAt"))
        if ts is None:
            return None
        inputs = count(usage.get("inputTokens"))
        outputs = count(usage.get("outputTokens"))
        cache_w = count(usage.get("cacheWriteTokens"))
        cache_r = count(usage.get("cacheReadTokens"))
        if inputs is None or outputs is None or cache_w is None or cache_r is None:
            return None
        fresh = inputs - cache_w - cache_r
        if fresh < 0:
            return None
        if fresh + cache_w + outputs == 0 and cache_r == 0:
            # An aborted request that never reached a model is not a turn.
            return None
        rid = d.get("requestId")
        if not usable_zcode_id(rid):
            # Persist the warning flag with this file's scan state: many bad
            # records and repeated polls must not flood the shell journal.
            if not state.get("warnedZcodeId"):
                print("burnbar-collect: Zcode skipped record with unusable requestId",
                      file=sys.stderr)
                state["warnedZcodeId"] = True
            return None
        model = d.get("model") if isinstance(d.get("model"), dict) else {}
        return [ts, fresh + cache_w + outputs, rid,
                str(model.get("modelId") or "zcode")[:64], [fresh, cache_w, outputs, cache_r]]
    except MALFORMED:
        return None


# ── aggregation ──────────────────────────────────────────────────────────────
class Agent:
    def __init__(self, key):
        self.key = key
        self.by_model = {}
        self.files = 0
        self.split = {"input": 0, "cacheWrite": 0, "output": 0, "cacheRead": 0}
        self.turns = 0
        self.first = 0
        self.last = 0
        self.total = 0
        self.m5 = 0
        self.m60 = 0

    def add(self, pt):
        ts, tokens, model = pt[0], pt[1], pt[3] if len(pt) > 3 else self.key
        b = bucket_for(ts)
        if b is not None:
            b[self.key] += tokens
        if not in_window(ts):
            return False
        self.total += tokens
        if ts >= t5:
            self.m5 += tokens
        if ts >= t60:
            self.m60 += tokens
        self.by_model[model] = self.by_model.get(model, 0) + tokens
        part = pt[4] if len(pt) > 4 else None
        if isinstance(part, list) and len(part) == 4:
            self.split["input"] += part[0]
            self.split["cacheWrite"] += part[1]
            self.split["output"] += part[2]
            self.split["cacheRead"] += part[3]
        self.turns += 1
        self.first = ts if not self.first or ts < self.first else self.first
        self.last = max(self.last, ts)
        return True

    def payload(self):
        peak = max((b[self.key] for b in buckets), default=0)
        return {
            "total": self.total,
            "peak": peak,
            "peakAt": max(buckets, key=lambda b: b[self.key])["t"] if peak > 0 else 0,
            "trailing": {"m5": self.m5, "m60": self.m60},
            "sessions": self.files,
            "turns": self.turns,
            "firstAt": self.first,
            "lastAt": self.last,
            "split": self.split,
            "byModel": self.by_model,
        }


claude = Agent("claude")
codex = Agent("codex")
# Kimi Code speaks the Anthropic API, so running it through Claude Code writes
# its turns into ~/.claude/projects alongside Claude's own. Nothing but the
# model id tells them apart, and without this split Kimi's spend is billed to
# Claude's lane: the one number Fred reads to see how close the wall is.
kimi = Agent("kimi")


def is_kimi_model(model):
    return str(model or "").lower().startswith(("kimi", "moonshot"))

# Claude: every revision of a streamed message carries the same id; the last
# revision has the most output and is the one that counts. Anonymous points
# (no id) are kept as they are.
best = {}
anonymous = []
file_of = {}
for f in walk(CLAUDE_ROOT, lambda n: n.endswith(".jsonl")):
    for pt in scan(f, claude_extract):
        try:
            mid = pt[2] if len(pt) > 2 else ""
        except Exception:
            continue
        if not mid:
            anonymous.append((pt, f))
            continue
        held = best.get(mid)
        if held is None or pt[1] > held[0][1] or (pt[1] == held[0][1] and pt[0] > held[0][0]):
            best[mid] = (pt, f)
touched = set()
kimi_touched = set()
# Presence for Kimi cannot be "a transcript directory exists" the way it is for
# the others: Kimi has no directory of its own. It is "a Kimi-model turn is in
# the transcripts we scanned", which the prune bound holds at about a day.
kimi_seen = False
for pt, f in list(best.values()) + anonymous:
    try:
        if is_kimi_model(pt[3] if len(pt) > 3 else ""):
            kimi_seen = True
            if kimi.add(pt):
                kimi_touched.add(f)
        elif claude.add(pt):
            touched.add(f)
    except Exception:
        continue
claude.files = len(touched)
kimi.files = len(kimi_touched)

touched = set()
for f in walk(CODEX_ROOT, lambda n: n.startswith("rollout-") and n.endswith(".jsonl")):
    for pt in scan(f, codex_extract):
        try:
            if codex.add(pt):
                touched.add(f)
        except Exception:
            continue
codex.files = len(touched)


# ── Grok (Grok Bot / Build sessions under ~/.grok) ───────────────────────────
# updates.jsonl carries _meta.totalTokens per streamed chunk, keyed by
# promptId. That figure is context size, not an API ledger; the rise within a
# single prompt is the closest durable per-turn signal Grok leaves on disk.
# summary.json supplies the model id for by-model when present.

def grok_model_for(session_dir):
    try:
        summary = json.loads((session_dir / "summary.json").read_text())
    except (OSError, ValueError, TypeError):
        return "grok"
    if not isinstance(summary, dict):
        return "grok"
    model = str(summary.get("current_model_id") or "")
    if not model:
        info = summary.get("info") if isinstance(summary.get("info"), dict) else {}
        model = str(info.get("model_id") or info.get("model") or "")
    return (model or "grok")[:64]


def grok_points_from_updates(path):
    """One point per promptId whose totalTokens rose during the prompt."""
    by = {}
    try:
        with path.open("rb") as fh:
            data = fh.read()
    except OSError:
        return []
    cut = data.rfind(b"\n")
    if cut == -1:
        return []
    model = grok_model_for(path.parent)
    for raw in data[:cut].split(b"\n"):
        if not raw or b"totalTokens" not in raw:
            continue
        try:
            d = json.loads(raw.decode("utf-8", "replace"))
        except MALFORMED:
            continue
        if not isinstance(d, dict):
            continue
        # _meta rides on params for session/update records (not the top level).
        params = d.get("params") if isinstance(d.get("params"), dict) else {}
        meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
        if not meta and isinstance(d.get("_meta"), dict):
            meta = d.get("_meta")
        # count() reads a MISSING usage field as zero, which is right for an
        # optional cache counter and wrong here: a record with no totalTokens
        # would drag this prompt's minimum to 0 and bill the whole context.
        if meta.get("totalTokens") is None:
            continue
        tt = count(meta.get("totalTokens"))
        if tt is None:
            continue
        pid = str(meta.get("promptId") or "")[:64]
        if not pid:
            continue
        ts = meta.get("turnStartMs")
        if not isinstance(ts, (int, float)) or isinstance(ts, bool):
            ts = meta.get("agentTimestampMs")
        if not isinstance(ts, (int, float)) or isinstance(ts, bool):
            ts = d.get("timestamp")
            if isinstance(ts, (int, float)) and not isinstance(ts, bool) and ts < 10**12:
                ts = ts * 1000
        if not isinstance(ts, (int, float)) or isinstance(ts, bool):
            continue
        ts = int(ts)
        held = by.get(pid)
        if held is None:
            by[pid] = {"ts": ts, "min": tt, "max": tt}
        else:
            held["min"] = min(held["min"], tt)
            held["max"] = max(held["max"], tt)
            if ts < held["ts"]:
                held["ts"] = ts
    points = []
    for pid, info in by.items():
        delta = info["max"] - info["min"]
        if delta <= 0:
            continue
        points.append([info["ts"], delta, pid, model, [delta, 0, 0, 0]])
    return prune(points)


# The newest write to ANY Grok session file, including ones too old to scan.
# Grok's quota is a snapshot taken when Grok starts, so the only honest way to
# know whether that snapshot still describes the plan is to know whether Grok
# has been used since, however long ago the snapshot was taken.
GROK_NEWEST = {"ms": 0}


def scan_grok(path):
    """Cache-aware Grok updates.jsonl reader (full reparse when the file moves)."""
    try:
        st = path.stat()
    except OSError:
        return []
    GROK_NEWEST["ms"] = max(GROK_NEWEST["ms"], int(st.st_mtime * 1000))
    if st.st_mtime * 1000 < scan_floor:
        return []
    key = str(path)
    hit = valid_entry(cache.get(key))
    if hit and hit["size"] == st.st_size and hit["mtime"] == st.st_mtime:
        hit = dict(hit, points=prune(hit["points"]))
        next_cache[key] = hit
        return hit["points"]
    try:
        points = grok_points_from_updates(path)
        tail = read_tail(path, st.st_size)
    except Exception:
        next_cache.pop(key, None)
        return []
    next_cache[key] = {"size": st.st_size, "mtime": st.st_mtime, "offset": st.st_size,
                       "tail": tail, "points": points, "state": {}}
    return points


grok = Agent("grok")
touched = set()
for f in walk(GROK_ROOT, lambda n: n == "updates.jsonl"):
    for pt in scan_grok(f):
        try:
            if grok.add(pt):
                touched.add(f)
        except Exception:
            continue
grok.files = len(touched)


# ── Zcode (Z.ai's coding agent, ~/.zcode/cli/rollout) ────────────────────────
# The rollout store is a ring, not a ledger: at most three model-io files, a
# 64 MiB cap that turns the newest into one reset line, and the oldest
# deleted outright. A file that shrinks or vanishes is housekeeping, not a
# correction of bad data, so the points it already contributed are kept until
# they age out of the window; the request id on every line keeps the union
# with a re-read honest.
zcode = Agent("zcode")
touched = set()
zcode_ids = set()


def zcode_keep(pt, f):
    rid = pt[2] if len(pt) > 2 else ""
    if not usable_zcode_id(rid) or rid in zcode_ids:
        return
    zcode_ids.add(rid)
    if zcode.add(pt):
        touched.add(f)


def zcode_union(held, fresh_pts):
    union, seen_ids = [], set()
    for pt in list(held) + list(fresh_pts):
        rid = pt[2] if len(pt) > 2 else ""
        if not usable_zcode_id(rid) or rid in seen_ids:
            continue
        seen_ids.add(rid)
        union.append(pt)
    return union


def zcode_root_of(path_text):
    return path_text.startswith(str(ZCODE_ROOT) + os.sep)


# Older Zcode cache points truncated IDs to 64 characters and admitted
# anonymous requests. Only this lane needs rebuilding; other agents retain
# their caches. Deleted legacy rollouts cannot recover their full identity,
# so discard those points rather than risk carrying duplicate usage forward.
for key in list(cache):
    if zcode_root_of(key):
        entry = valid_entry(cache[key])
        if not entry or entry.get("zcodeIdentityVersion") != 1:
            del cache[key]


walked = set()
for f in walk(ZCODE_ROOT, lambda n: n.startswith("model-io-") and n.endswith(".jsonl")):
    key = str(f)
    walked.add(key)
    held = []
    prev = valid_entry(cache.get(key)) if cache else None
    if prev:
        held = prune(prev.get("points") or [])
    fresh_pts = scan(f, zcode_extract)
    union = zcode_union(held, fresh_pts)
    for pt in union:
        try:
            zcode_keep(pt, f)
        except Exception:
            continue
    entry = next_cache.get(key)
    if entry is not None:
        entry["points"] = union
        entry["zcodeIdentityVersion"] = 1
    elif prev is not None and union:
        next_cache[key] = dict(prev, points=union)

# Rotation also deletes files outright. Whatever the cache still holds for a
# zcode path that is no longer on disk keeps counting until it ages out, and
# the entry is carried forward so the run after this one can do the same.
if cache:
    for key, raw in cache.items():
        if key in walked or not zcode_root_of(key):
            continue
        entry = valid_entry(raw)
        if not entry:
            continue
        pts = zcode_union(prune(entry.get("points") or []), [])
        if not pts:
            continue
        for pt in pts:
            try:
                zcode_keep(pt, Path(key))
            except Exception:
                continue
        next_cache[key] = dict(entry, points=pts)
zcode.files = len(touched)


def grok_limits_from_log():
    """Weekly credit %% from the newest billing snapshot in unified.jsonl."""
    latest = None
    measured = 0
    try:
        with GROK_LOG.open("rb") as fh:
            data = fh.read()
    except OSError:
        return [], 0, ""
    for raw in data.split(b"\n"):
        if b"billing: fetched credits config" not in raw:
            continue
        try:
            entry = json.loads(raw.decode("utf-8", "replace"))
        except MALFORMED:
            continue
        if not isinstance(entry, dict) or entry.get("msg") != "billing: fetched credits config":
            continue
        ctx = entry.get("ctx") if isinstance(entry.get("ctx"), dict) else {}
        config = ctx.get("config") if isinstance(ctx.get("config"), dict) else {}
        if not config:
            continue
        latest = dict(config)
        if ctx.get("subscriptionTier"):
            latest["subscriptionTier"] = ctx.get("subscriptionTier")
        measured = parse_ts(entry.get("ts")) or 0
    if not latest:
        return [], 0, "Grok billing data unavailable"
    period = latest.get("currentPeriod") if isinstance(latest.get("currentPeriod"), dict) else {}
    reset_at = str(period.get("end") or latest.get("billingPeriodEnd") or "")[:40]
    try:
        # Grok logs creditUsagePercent on a 0..100 scale; Burn Bar stores 0..1.
        # A config without the figure is UNKNOWN: defaulting it to 0 published a
        # confident, green 0% for a plan nobody had measured.
        raw_percent = latest.get("creditUsagePercent")
        percent = -1.0 if raw_percent is None or isinstance(raw_percent, bool) \
            else norm_percent(float(raw_percent) / 100.0)
    except (TypeError, ValueError, OverflowError):
        percent = -1.0
    limits = [{"label": "Weekly (7-day)", "percent": percent, "resetsAt": reset_at}]
    return limits, measured, ""


def window_open(limits, now):
    """True when at least one window in the set has not already reset. A limit
    with no reset time cannot be judged either way, so it counts as open."""
    for l in limits or []:
        end = parse_iso_ms(l.get("resetsAt"))
        if not end or end > now:
            return True
    return False


def pick_limits(candidates, now):
    """Choose between limit sets from different sources. A window that is still
    open always beats one that has already reset; a reset window is last
    week's answer no matter how recently it was written down. Between two of
    the same kind the more recently measured wins. None when nothing is usable."""
    best = None
    for limits, measured, status in candidates:
        if not limits:
            continue
        rank = (1 if window_open(limits, now) else 0, measured)
        if best is None or rank > best[0]:
            best = (rank, (limits, measured, status))
    return best[1] if best else None


def with_grok_limits(agent_payload):
    # Grok has no stock Omarchy probe, so nothing ever refreshes
    # agents/usage/grok.json: once that record exists it is frozen at whatever
    # it said the day it was written. Preferring it whenever it merely had a
    # `limits` array pinned Grok's weekly figure to that day forever, and an
    # expired window read as a confident 0%. ~/.grok/logs/unified.jsonl is the
    # live source; choose between them on evidence rather than on order.
    chosen = pick_limits([limits_for("grok"), grok_limits_from_log()], now_ms)
    if chosen is None:
        agent_payload["limits"] = []
        agent_payload["limitsMeasuredAt"] = 0
        agent_payload["limitsStatus"] = "Grok billing data unavailable"
        # Grok carries its own remedy in the status text ("run grok to
        # refresh"); the key is still set so every agent has the same shape.
        agent_payload["limitsHelp"] = ""
        return agent_payload
    limits, measured, status = chosen
    if not status and not window_open(limits, now_ms):
        # Say so rather than presenting last week's window as this week's.
        status = "Grok window has reset; run grok to refresh"
    agent_payload["limits"] = limits
    agent_payload["limitsMeasuredAt"] = measured
    agent_payload["limitsStatus"] = status
    agent_payload["limitsHelp"] = ""
    return agent_payload


def agent_present(root, match):
    """True when this machine has actually used the agent: a transcript file
    exists under its local root. A binary on PATH with
    no sessions is not 'in use'; that would light Claude on every Omarchy
    box."""
    return next(walk(root, match), None) is not None


# Present means 'this machine uses this agent', not 'tokens in the window'.
# A quiet hour must not hide a lane that was installed yesterday.
claude_present = agent_present(CLAUDE_ROOT, lambda n: n.endswith(".jsonl"))
codex_present = agent_present(CODEX_ROOT, lambda n: n.startswith("rollout-") and n.endswith(".jsonl"))
grok_present = agent_present(GROK_ROOT, lambda n: n == "updates.jsonl")
# Presence is not only "a rollout file exists": rotation deletes files while
# their requests are still inside the window, and a lane with counted burn
# must not hide because its store was tidied.
zcode_present = (agent_present(ZCODE_ROOT, lambda n: n.startswith("model-io-") and n.endswith(".jsonl"))
                 or bool(zcode_ids))
def kimi_configured():
    """True when this machine is set up for Kimi at all: its plan or its quota
    came back from Kimi's own API. Fred, 2026-09-20: "It should default on
    install to all known lanes for that machine." Kimi Code rides inside
    Claude's transcripts, so a machine that has Kimi configured but has not run
    a Kimi-model turn today would otherwise show no Kimi lane and no Kimi in the
    token mix, while its plan rows sat in the cockpit saying otherwise."""
    for name in ("kimi-usage.json", "kimi-plan.json"):
        try:
            raw = json.loads((OUT_DIR / name).read_text())
        except (OSError, ValueError, TypeError):
            continue
        if not isinstance(raw, dict):
            continue
        if raw.get("limits") or raw.get("tier"):
            return True
    return False


kimi_present = kimi_seen or kimi.total > 0 or kimi_configured()
if not grok_present and GROK_LOG.is_file():
    grok_present = True


# ── local (Ollama) tokens, from the ollama-meter journal on the Ollama box ───
# One line per request, written by nano/ollama-meter.py (journalctl -o short-unix):
#   1788649667.804220 nano python3[9143]: meter ts=1788649667803 path=/api/generate \
#       model=llama3.2:3b status=200 prompt=33 eval=53 ms=2744 client=100.64.0.2
# prompt is prompt_eval_count: tokens actually evaluated; Ollama does not
# report cache hits, and eval is eval_count. -1 means the response never
# carried the number (an error, a cut-off stream). Only status 200 counts.
JOURNAL_KEY = "journal:" + METER_HOST + ":" + METER_UNIT
JOURNAL_MATCH = "meter ts="
# Ollama's own server journal is a per-request ledger when the dedicated meter
# is not installed. One task logs a pair of lines:
#   ... | task 8079 | prompt eval time =  218.53 ms /   15 tokens (...)
#   ... | task 8079 |        eval time = 79998.83 ms / 1494 tokens (...)
# The prompt line is absent when the whole prompt was already cached, so a task
# is emitted on its eval line with whatever prompt was seen for it.
OLLAMA_UNIT = str_arg("--ollama-unit", os.environ.get("BURNBAR_OLLAMA_UNIT") or "ollama")
OLLAMA_MATCH = "print_timing"
RE_OLLAMA_PROMPT = re.compile(
    r"^(\d+(?:\.\d+)?)\s.*\btask\s+(\d+)\s*\|\s*prompt eval time\s*=\s*[\d.]+\s*ms\s*/\s*(\d+)\s*tokens")
RE_OLLAMA_EVAL = re.compile(
    r"^(\d+(?:\.\d+)?)\s.*\btask\s+(\d+)\s*\|\s*eval time\s*=\s*[\d.]+\s*ms\s*/\s*(\d+)\s*tokens")
RE_METER = re.compile(r"^\d+\.\d+\s+\S+\s+\S+:\s+meter ts=(\d+) path=(\S+) model=(\S+) status=(\d+) "
                      r"prompt=(-?\d+) eval=(-?\d+)")


_FQDN = None


def fqdn_once():
    """socket.getfqdn() does a reverse lookup that blocks for 5s on a host
    whose name does not resolve, and the collector runs every few seconds. Ask
    at most once per process, and only when the cheap names have already
    missed."""
    global _FQDN
    if _FQDN is None:
        try:
            _FQDN = socket.getfqdn().strip().rstrip(".").lower()
        except OSError:
            _FQDN = ""
    return _FQDN


def is_local_host(host):
    """True when the meter host is this machine, so nothing goes over ssh.

    Same rule as burnbar-local-status.is_local_host; both scripts have to agree
    or the lane discovers a GPU locally and then fails to read its journal."""
    name = str(host or "").strip().split("@")[-1].rstrip(".").lower()
    if not name or name in ("localhost", "127.0.0.1", "::1"):
        return True
    try:
        short = socket.gethostname().strip().rstrip(".").lower()
    except OSError:
        return False
    if name == short or name == short.split(".")[0]:
        return True
    return bool(name) and name == fqdn_once()


def ssh_command(argv):
    """argv on the Ollama box. BatchMode so a missing key fails instead of
    prompting a process nobody can see; the host is the user's own ssh alias
    and is passed after '--' so it can never read as an option. ssh joins
    the remote words with spaces and hands them to a shell, so each one is
    quoted here: "-g 'meter ts='" used to arrive as two arguments.

    When the box IS this machine, run it directly. Wrapping a local command in
    ssh needs a key and a trusted host key for localhost, and on a host without
    them the GPU lane discovered a card and then reported zero tokens with
    "Host key verification failed" as the only clue."""
    if is_local_host(METER_HOST):
        return list(argv)
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "-o", "LogLevel=ERROR",
            "--", METER_HOST, " ".join(shlex.quote(word) for word in argv)]


def journal_lines(cursor, unit=None, match=None):
    """(lines, new_cursor, error). The meter's journal after the saved cursor,
    or since the window opened when there is none. Tests point
    BURNBAR_METER_JOURNAL at a file in the same short-unix shape."""
    override = os.environ.get("BURNBAR_METER_JOURNAL")
    if override is not None:
        try:
            return Path(override).read_text(errors="replace").splitlines(), "", ""
        except OSError as e:
            return [], "", ("journal unreadable: %s" % e)[:160]
    # No -q: it also silences journalctl's own error text, and a bare "exited 1"
    # helps nobody. The "-- No entries --" line it lets through matches nothing.
    unit = unit or METER_UNIT
    match = match or JOURNAL_MATCH
    base = ["journalctl", "-u", unit, "-o", "short-unix", "--no-pager", "--show-cursor"]
    base += ["--after-cursor", cursor] if cursor else ["--since", "@%d" % (scan_floor // 1000)]
    for cmd in (base + ["-g", match], base):
        try:
            run = subprocess.run(ssh_command(cmd), capture_output=True, text=True, timeout=20)
        except FileNotFoundError:
            return [], "", "ssh not found"
        except subprocess.SubprocessError as e:
            return [], "", ("ssh %s failed: %s" % (METER_HOST, e))[:160]
        # journalctl exits 1, with nothing on stderr, when -g matched no entry
        # which on the cursor path is the normal case between two runs.
        # Only an exit with an actual message is a failure.
        stderr = run.stderr.strip()
        if run.returncode == 0 or (run.returncode == 1 and not stderr):
            lines = run.stdout.splitlines()
            new_cursor = ""
            if lines and lines[-1].startswith("-- cursor: "):
                new_cursor = lines.pop().split(": ", 1)[1].strip()
            # journalctl's own notes ("-- No entries --") are not data. Leaving
            # them in made a unit that does not exist look like a unit that was
            # merely quiet, which silenced the "is it installed?" probe below
            # and published an available lane reading zero tokens.
            lines = [l for l in lines if not (l.startswith("-- ") and l.endswith(" --"))]
            return lines, new_cursor, ""
        err = (stderr.splitlines() or ["journalctl exited %d" % run.returncode])[-1]
        # A systemd built without pattern matching: read unfiltered instead.
        if "-g" in cmd and "pattern" in err.lower():
            continue
        return [], "", ("%s: %s" % (METER_HOST, err))[:160]
    return [], "", "journalctl on %s failed" % METER_HOST


def parse_journal(lines, state):
    """One point per metered request. `state` is kept for the cache entry's
    shape; the meter's lines are self-contained, so there is nothing to
    carry between reads."""
    points = []
    for line in lines:
        m = RE_METER.match(line)
        if not m:
            continue
        ts, path, model, status, prompt, generated = m.groups()
        if status != "200":
            continue
        prompt, generated = max(0, int(prompt)), max(0, int(generated))
        if prompt + generated <= 0:
            continue
        points.append([int(ts), prompt + generated, "", model[:64], [prompt, 0, generated, 0]])
    return points


def journal_source_args(source):
    """(unit, match) for the journal a cached read came from.

    The two sources log different line shapes, so a warm read has to go back to
    the one its kept points came from. Defaulting to METER_UNIT here is what
    froze the lane on a box that runs only Ollama: the fallback picks the Ollama
    unit on a cold read, but every read after that asked for a unit this host
    does not run, got nothing, and never advanced."""
    if source == "ollama":
        return OLLAMA_UNIT, OLLAMA_MATCH
    return METER_UNIT, JOURNAL_MATCH


def parse_ollama_journal(lines, state):
    """One point per completed Ollama request, read from the server's journal.

    No model name: these lines carry only a task id, and the runner is named by
    blob digest elsewhere, so attributing a friendly name would be a guess."""
    pending = state.setdefault("ollamaPrompt", {})
    points = []
    for line in lines:
        m = RE_OLLAMA_PROMPT.match(line)
        if m:
            pending[m.group(2)] = max(0, int(m.group(3)))
            continue
        m = RE_OLLAMA_EVAL.match(line)
        if not m:
            continue
        generated = max(0, int(m.group(3)))
        prompt = pending.pop(m.group(2), 0)
        if prompt + generated <= 0:
            continue
        points.append([int(float(m.group(1)) * 1000), prompt + generated, "",
                       "ollama", [prompt, 0, generated, 0]])
    # A prompt whose eval line never arrived must not accumulate forever.
    if len(pending) > 64:
        pending.clear()
    return points


def unit_missing(unit):
    """True only when systemd positively reports the unit as absent. If the
    probe itself fails we cannot tell, and guessing 'missing' would blame the
    wrong thing."""
    try:
        probe = subprocess.run(ssh_command(["systemctl", "show", "-p", "LoadState", "--value", unit]),
                               capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return probe.returncode == 0 and probe.stdout.strip() == "not-found"


def valid_journal_entry(hit):
    if not isinstance(hit, dict) or hit.get("journal") is not True:
        return None
    if not isinstance(hit.get("cursor", ""), str) or not isinstance(hit.get("state", {}), dict):
        return None
    points = hit.get("points")
    if not isinstance(points, list) or not all(valid_point(p) for p in points):
        return None
    return hit


local = Agent("local")
local_available = True
local_reason = ""
jhit = valid_journal_entry(cache.get(JOURNAL_KEY))
# Which journal the kept points came from. Two sources with different line
# shapes share this cache, so a cursor from one is meaningless to the other.
local_source = (jhit or {}).get("source") or "meter"
cursor = jhit["cursor"] if jhit else ""
state = dict(jhit["state"]) if jhit else {}
kept = list(jhit["points"]) if jhit else []
if NO_LOCAL:
    lines, new_cursor, err = [], "", "no discrete GPU"
    local_available = False
    local_reason = "no discrete GPU"
else:
    # Go back to the journal the kept points actually came from. The fallback
    # to Ollama's own unit below only fires on a cold read, so once it had
    # chosen that source every later run still asked METER_UNIT, a unit this
    # box does not run, and got nothing, forever. The lane stayed
    # "available" and simply stopped advancing at whatever its first read saw.
    read_unit, read_match = journal_source_args(local_source)
    lines, new_cursor, err = journal_lines(cursor, read_unit, read_match)
    # A cursor the journal can no longer seek to (a vacuumed file, or one it
    # simply refuses) fails the read. Re-read the window from scratch: that
    # returns the complete set for the window and replaces what was kept.
    if err and cursor:
        cursor, state, kept = "", {}, []
        lines, new_cursor, err = journal_lines("", read_unit, read_match)
    if err:
        local_available = False
        local_reason = err
    elif not cursor and not lines and os.environ.get("BURNBAR_METER_JOURNAL") is None:
        # A cold read that found nothing: is the meter even installed, or just
        # quiet? If it is absent, Ollama's own journal is itself a per-request
        # ledger: a GPU that is plainly busy must not report zero tokens just
        # because the optional meter was never installed on this box.
        if unit_missing(METER_UNIT):
            olines, ocursor, oerr = journal_lines("", OLLAMA_UNIT, OLLAMA_MATCH)
            if not oerr and olines:
                local_source, lines, new_cursor, err = "ollama", olines, ocursor, ""
                if jhit and (jhit.get("source") or "meter") != "ollama":
                    state, kept = {}, []      # the other shape's leftovers
            elif unit_missing(OLLAMA_UNIT):
                local_available = False
                local_reason = "%s runs neither %s nor %s" % (METER_HOST, METER_UNIT, OLLAMA_UNIT)
            else:
                local_available = False
                local_reason = "%s has no %s unit and %s has logged no requests" % (
                    METER_HOST, METER_UNIT, OLLAMA_UNIT)
# Guarded like every transcript scan: the parsers trust the SHAPE of the cached
# state, and a cache whose nested maps were corrupted raised here, outside any
# try, and took the whole run (every cloud lane included) down with it.
try:
    if err:
        local_points = prune(kept)
    elif local_source == "ollama":
        local_points = prune(kept + parse_ollama_journal(lines, state))
    else:
        local_points = prune(kept + parse_journal(lines, state))
except Exception:
    state, local_points = {}, prune(kept if isinstance(kept, list) else [])
for pt in local_points:
    try:
        local.add(pt)
    except Exception:
        continue


# ── local tokens Ollama's journal never sees ─────────────────────────────────
# local-ai (TabbyAPI) and an NPU embedder keep no per-request ledger, so the
# callers that use them append one line each to this file:
#   {"ts": 1789291801000, "source": "local-ai", "model": "Qwen3.5-9B-EXL3-4bpw",
#    "prompt": 812, "output": 64, "estimated": true}
# Calls that go to Ollama are never written here; the journal above already
# counts them, and writing them twice would double the offload share. These
# points are scanned (and cached) as a file, separately from the journal
# cursor, so a journal failure never drops them and they never enter its cache.
LOCAL_LEDGER = Path(os.environ.get("BURNBAR_LOCAL_LEDGER") or OUT_DIR / "local-usage.jsonl")


def ledger_extract(line, _state):
    try:
        rec = json.loads(line)
        # Not count(): an epoch in ms is past MAX_TOKENS, so it would read as junk.
        ts = rec.get("ts")
        if isinstance(ts, float) and ts.is_integer():
            ts = int(ts)
        if not isinstance(ts, int) or isinstance(ts, bool) or ts <= 0:
            return None
        prompt, output = count(rec.get("prompt")), count(rec.get("output"))
        source = str(rec.get("source") or "").strip()[:24]
        model = str(rec.get("model") or "").strip()[:40]
    except MALFORMED:
        return None
    if prompt is None or output is None or not source or prompt + output <= 0:
        return None
    name = source + ":" + model if model else source
    return [ts, prompt + output, "", name, [prompt, 0, output, 0]]


for pt in scan(LOCAL_LEDGER, ledger_extract):
    try:
        local.add(pt)
    except Exception:
        continue
if not err:
    next_cache[JOURNAL_KEY] = {"journal": True, "cursor": new_cursor or cursor,
                               "source": local_source, "state": state, "points": local_points}
elif jhit:
    next_cache[JOURNAL_KEY] = jhit


# ── limits, straight off the records omarchy-agent-usage-update maintains ────
# The record is copied, not trusted. Three things travel with the numbers so
# the widget can tell a live figure from a leftover:
#   measuredAt, when the figure was actually measured. The record's own
#     updatedAt is stamped every time it is rewritten, and Omarchy's Claude
#     collector rewrites it with its *cached* limits when the probe fails or
#     the sign-in has lapsed, so updatedAt alone lets an old 0% wear a fresh
#     timestamp. The probe cache beside it (claude-limits.json) carries
#     fetchedAtMs, written only by a successful probe; that is the truth when
#     it exists. Codex keeps no fallback cache, so its updatedAt is honest.
#   status: the record's own words ("Sign-in expired", "Waiting for auth"),
#     or a note that the last probe failed and these are the last known.
#   percent: normalised per entry; anything that is not a finite 0..1
#     fraction becomes -1, an explicit "unknown", never 0 and never a crash.
# Whether a window has since rolled over is judged live in QML from resetsAt.
def parse_iso_ms(raw):
    raw = str(raw or "").strip()
    if not raw:
        return 0
    try:
        return int(datetime.datetime.fromisoformat(raw.replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return 0


def norm_percent(value):
    # bool is an int in Python; True would otherwise read as a confident 100%.
    if isinstance(value, bool):
        return -1.0
    try:
        n = float(value)
    except (TypeError, ValueError, OverflowError):
        return -1.0
    if n != n or n in (float("inf"), float("-inf")) or n < 0 or n > 1:
        return -1.0
    return n


def probe_measured_at(agent):
    try:
        cache_doc = json.loads((PROBE_CACHE_DIR / f"{agent}-limits.json").read_text())
        return int(cache_doc.get("fetchedAtMs") or 0) if isinstance(cache_doc, dict) else 0
    except (OSError, ValueError, TypeError, OverflowError):
        return 0


# ── budget pace: am I over, and will I make it to the reset? ─────────────────
# Fred, 2026-09-20: "tell me when I'm over budget ... if I will make it to my
# next reset if I keep consuming at the same rate ... when I get back into
# 'making it'."
#
# On budget means EVEN PACE across the window: a tenth of the way in, a tenth of
# the allowance is a fair spend. Everything here falls out of four numbers per
# row - used fraction p, time left r, window length L, and a rate measured from
# our own samples:
#
#   elapsed    e = (L - r) / L
#   pace       R = p / e           1.0 is exactly on pace, above it is over
#   allowance  s = (1 - p) / r     what may still be burned per hour and make it
#   forecast   P = p + rate * r    above 1.0 means the window runs dry early
#   dry at     now + (1 - p) / rate
#   on pace    again at reset - L * (1 - p), and only if the burning stops
#
# Every percentage is the provider's own; nothing is invented. A row whose rate
# cannot be measured says so (-1) instead of guessing: Grok writes its figure
# once per Grok Bot launch, which is enough for R and not for a rate.
SAMPLES_FILE = OUT_DIR / "limit-samples.jsonl"
SAMPLE_MAX_AGE_MS = 40 * 86400_000     # a monthly window plus slack
SAMPLE_MIN_GAP_MS = 5 * 60_000         # the collector ticks every few seconds
RATE_WINDOW_MS = 120 * 60_000          # the rate is measured over 2h of samples
RATE_WINDOW_SHARE = 0.10               # ... or a tenth of a short window (30 min of a 5h one)
RATE_MIN_SPAN_MS = 10 * 60_000         # ... and needs a real span, not two ticks
DAILY_MIN_WINDOW_MS = 36 * 3600_000    # "today's budget" is meaningless in a 5h window

PACE = {"samples": {}, "next": []}


def window_ms_for(label, resets_ms, prev_resets_ms):
    """How long the window is. The label carries it whenever the provider says
    so ("Session (5-hour)", "Weekly (7-day)"); otherwise the distance to the
    previous reset is the measurement, which is why samples keep that reset."""
    text = str(label or "").lower()
    m = re.search(r"(\d+)\s*-\s*(hour|day)", text)
    if m:
        return int(m.group(1)) * (3600_000 if m.group(2) == "hour" else 86400_000)
    if "week" in text:
        return 7 * 86400_000
    if "month" in text:
        # A month is not 30 days everywhere: step back one calendar month from
        # the reset so a February window is February long.
        if resets_ms:
            end = datetime.datetime.fromtimestamp(resets_ms / 1000, datetime.timezone.utc)
            y, mo = (end.year, end.month - 1) if end.month > 1 else (end.year - 1, 12)
            day = end.day
            while day > 28:
                try:
                    start = end.replace(year=y, month=mo, day=day)
                    break
                except ValueError:
                    day -= 1
            else:
                start = end.replace(year=y, month=mo, day=day)
            return max(86400_000, int((end - start).total_seconds() * 1000))
        return 30 * 86400_000
    if "session" in text:
        return 5 * 3600_000
    if "daily" in text or "day" in text:
        return 86400_000
    if prev_resets_ms and resets_ms > prev_resets_ms:
        return resets_ms - prev_resets_ms
    return 0


def load_samples():
    """{key: [(ts, percent, resetsMs)]} oldest first, pruned to what can still
    be asked about. A malformed line is skipped, never fatal."""
    out = {}
    try:
        data = SAMPLES_FILE.read_bytes()
    except OSError:
        return out
    floor = now_ms - SAMPLE_MAX_AGE_MS
    for raw in data.split(b"\n"):
        if not raw:
            continue
        try:
            rec = json.loads(raw)
            ts = int(rec["ts"])
            key = str(rec["key"])[:96]
            pct = float(rec["pct"])
            resets = int(rec.get("resets") or 0)
        except MALFORMED:
            continue
        if ts < floor or ts > now_ms + FUTURE_SLACK_MS or not (0 <= pct <= 1):
            continue
        out.setdefault(key, []).append((ts, pct, resets))
    for v in out.values():
        v.sort()
    return out


def save_samples():
    """Rewrite the file with what was kept plus this run's new samples. It is
    small (one line per window per 5 minutes) and rewriting keeps the prune
    honest, so there is no cursor to get out of step."""
    lines = []
    for key, points in PACE["samples"].items():
        for ts, pct, resets in points:
            lines.append(json.dumps({"ts": ts, "key": key, "pct": round(pct, 6), "resets": resets}))
    lines.extend(PACE["next"])
    if not lines:
        return
    try:
        write_atomic(SAMPLES_FILE, "\n".join(lines) + "\n")
    except Exception:
        pass


def recent_rate_per_hour(points, window_ms=0):
    """Least squares slope over the recent samples, as fraction per hour. The
    fit covers the last RATE_WINDOW_MS, or a tenth of the limit's own window
    when that is shorter: two hours is 40% of a 5-hour window, and a fit that
    long reads a burst after a quiet spell as a trickle until the window is
    nearly gone. Windows of 20 hours and up keep the two-hour fit. None when the
    samples cannot carry a rate: fewer than two, too short a span, or a
    percentage that went DOWN inside the span, which is a reset, not a
    negative burn."""
    if len(points) < 2:
        return None
    fit = RATE_WINDOW_MS
    if window_ms > 0:
        fit = min(fit, int(window_ms * RATE_WINDOW_SHARE))
    floor = points[-1][0] - fit
    pts = [(t, p) for t, p, _ in points if t >= floor]
    if len(pts) < 2 or pts[-1][0] - pts[0][0] < RATE_MIN_SPAN_MS:
        return None
    for i in range(1, len(pts)):
        if pts[i][1] < pts[i - 1][1] - 1e-9:
            return None
    n = len(pts)
    mt = sum(t for t, _ in pts) / n
    mp = sum(p for _, p in pts) / n
    denom = sum((t - mt) ** 2 for t, _ in pts)
    if denom <= 0:
        return None
    slope = sum((t - mt) * (p - mp) for t, p in pts) / denom
    return max(0.0, slope * 3600_000)


def local_midnight_ms():
    d = datetime.datetime.fromtimestamp(now_ms / 1000)
    return int(d.replace(hour=0, minute=0, second=0, microsecond=0).timestamp() * 1000)


def window_id(resets_ms):
    """Which window instance this is, to the minute. Providers re-state the same
    reset with millisecond jitter - Claude's weekly moved across 56 distinct
    values inside one second - and matching those exactly meant a sample almost
    never belonged to "this" window, so no rate could ever form and no
    acknowledgement could ever stick."""
    return (int(resets_ms) // 60_000) * 60_000



SERIES_MAX_POINTS = 48

GIFT_MIN_DROP = 0.03                   # a provider restating 41% as 40% is not a gift
GIFT_ID_SLACK_MS = 2 * 60_000          # the same reset, restated a minute either side


def gift_reset_at(points, resets, pct_now):
    """When the provider last wiped this window's usage WITHOUT moving its reset.
    Fred, 2026-10-01: "every once in a while the AI gods get really friendly ...
    your tokens reset back to zero until your next normal reset." Claude did it
    on Thu 2026-10-01 20:38: weekly 53% -> 0% with the reset still Sunday 06:00.
    A percentage only ever climbs inside one window, so a real fall while the
    reset stays put is that gift, and the whole plan now has to last only from
    that moment to the reset. 0 when there has been none. The moment is the
    first sample AFTER the fall: the later bound, so nothing is banked that the
    clock has not really earned."""
    mine = [(t, p) for t, p, r in points if abs(r - resets) <= GIFT_ID_SLACK_MS and t <= now_ms]
    mine.append((now_ms, float(pct_now)))
    at = 0
    for i in range(1, len(mine)):
        if mine[i][1] < mine[i - 1][1] - GIFT_MIN_DROP + 1e-9:
            at = mine[i][0]
    return int(at)


def burndown_series(points, resets, window, pct_now, since=0):
    """This window's own samples as [x, y] pairs in 0..1, thinned to at most
    SERIES_MAX_POINTS and always ending on the present moment, so the line the
    card draws stops exactly where the hero number says you are."""
    start = resets - window
    mine = [(t, p) for t, p, r in points if r == resets and max(start, since) <= t <= now_ms]
    if len(mine) > SERIES_MAX_POINTS - 1:
        step = len(mine) / float(SERIES_MAX_POINTS - 1)
        mine = [mine[int(i * step)] for i in range(SERIES_MAX_POINTS - 1)]
    out = [[round((t - start) / float(window), 5), round(p, 5)] for t, p in mine]
    out.append([round(min(1.0, max(0.0, (now_ms - start) / float(window))), 5), round(float(pct_now), 5)])
    return out


def pace_for(row, key, live):
    """The pace block for one limit row. Unknowns are -1 (a rate we cannot
    measure) or 0 (a moment that does not apply), never an invented number."""
    pct = row.get("percent")
    resets = window_id(parse_iso_ms(row.get("resetsAt")))
    # resetsMs identifies WHICH window instance this is. A warning answered in
    # one window must not stay answered into the next, and backOnPaceAt cannot
    # play that role: it moves every time the percentage does.
    out = {"windowMs": 0, "resetsMs": 0, "elapsed": -1, "ratio": -1, "allowancePerHour": -1,
           "ratePerHour": -1, "projected": -1, "dryAt": 0, "backOnPaceAt": 0,
           "todayUsed": -1, "todayAllowance": -1, "overDaily": False,
           # Today's share of what is left, and when to put this subscription
           # down so tomorrow still has its own.
           "todayCeiling": -1, "stopInMs": -1, "stopAtMs": 0, "recoverInMs": -1,
           # The burndown the 2.0 cards draw: [[x, y]] with x the fraction of
           # the window elapsed and y the fraction of the plan spent, so the
           # even-pace line is simply the diagonal and "above it" means over.
           "series": [],
           # A surprise reset inside this window: when it landed, and how long
           # the window is on paper. windowMs is then what is left to budget
           # across, gift to reset, so every clock downstream re-bases itself.
           "giftAt": 0, "fullWindowMs": 0}
    if not isinstance(pct, (int, float)) or pct < 0 or not resets:
        return out
    points = PACE["samples"].get(key) or []
    prev_resets = 0
    for _, _, r in points:
        if r and r < resets:
            prev_resets = max(prev_resets, r)
    window = window_ms_for(row.get("label"), resets, prev_resets)
    left_ms = resets - now_ms
    if window <= 0 or left_ms <= 0:
        return out
    out["fullWindowMs"] = window
    gift = gift_reset_at(points, resets, pct)
    if gift and resets - window < gift < resets:
        # Same reset date, brand new plan: an even spend now runs from the gift
        # to the reset, and what was burned before it is no longer owed.
        out["giftAt"] = gift
        window = resets - gift
        points = [p for p in points if p[0] >= gift]
    out["windowMs"] = window
    out["resetsMs"] = int(resets)
    out["series"] = burndown_series(points, resets, window, pct, gift)
    elapsed = min(1.0, max(0.0, (window - left_ms) / float(window)))
    out["elapsed"] = elapsed
    hours_left = left_ms / 3600_000.0
    out["allowancePerHour"] = max(0.0, (1.0 - pct) / hours_left) if hours_left > 0 else 0.0
    # Ratio needs an elapsed window to divide by. In the first moments of a
    # window any spend divides by ~0 and reads as infinite; hold it until the
    # window is one percent old.
    if elapsed >= 0.01:
        out["ratio"] = pct / elapsed
    # Only the rows this machine samples can carry a rate.
    rate = recent_rate_per_hour([p for p in points if p[2] == resets], window) if live else None
    if rate is not None:
        out["ratePerHour"] = rate
        projected = pct + rate * hours_left
        out["projected"] = projected
        if rate > 0 and projected > 1.0:
            out["dryAt"] = int(now_ms + ((1.0 - pct) / rate) * 3600_000)
    # Stopping now, the window catches up with what was spent at this moment.
    if out["ratio"] > 1.0:
        out["backOnPaceAt"] = int(resets - window * (1.0 - pct))
    # Fred, 2026-09-20: "tell you that you should stop for the day with this sub
    # in $time to recover for the next day." An even spend gives the next 24
    # hours this slice of what is left; burning past it today is borrowing from
    # tomorrow. At the measured rate that slice has a clock on it.
    if window >= DAILY_MIN_WINDOW_MS and hours_left > 0:
        ceiling = max(0.0, (1.0 - pct) * min(1.0, 24.0 / hours_left))
        out["todayCeiling"] = ceiling
        # A rate near zero divides into "stop in 165 hours", which is not advice.
        # The clock is only worth printing when it lands inside the window.
        # And only when today's share really would run out today: at an even
        # pace this comes to about 24 hours, which told every on-track sub to
        # "stop in 23h". A slice that outlasts its own 24 hours needs no clock.
        if rate is not None and rate > 0.0005:
            hours = ceiling / rate
            if hours < 24.0 and hours * 3600_000 < left_ms:
                out["stopInMs"] = int(hours * 3600_000)
                out["stopAtMs"] = int(now_ms + hours * 3600_000)

    if window >= DAILY_MIN_WINDOW_MS:
        # After a gift, today starts at the gift: midnight's figure belongs to
        # the plan that was wiped.
        midnight = max(local_midnight_ms(), out["giftAt"])
        before = [p for p in points if p[0] <= midnight and p[2] == resets]
        if before:
            at_midnight = before[-1][1]
            out["todayUsed"] = max(0.0, pct - at_midnight)
            left_then = max(1.0, (resets - midnight) / 3600_000.0)
            # An even pace spends today the 24-hour share of what was left.
            out["todayAllowance"] = max(0.0, (1.0 - at_midnight) * min(1.0, 24.0 / left_then))
            out["overDaily"] = out["todayUsed"] > out["todayAllowance"] > 0
            # Already past today's share: the allowance accrues again at
            # todayCeiling per 24 hours, so that is how long being square takes.
            ceiling = out["todayCeiling"]
            if out["overDaily"] and ceiling > 0:
                over = out["todayUsed"] - out["todayAllowance"]
                recover = int((over / (ceiling / 24.0)) * 3600_000)
                # Later than the reset is not a recovery time, it is the reset.
                if recover < left_ms:
                    out["recoverInMs"] = recover
    return out


def with_pace(agent_payload, agent_name):
    """Attach pace to every limit row, and remember this run's percentages."""
    rows = agent_payload.get("limits")
    if not isinstance(rows, list):
        return agent_payload
    live = agent_payload.get("limitsLive") is not False
    for row in rows:
        if not isinstance(row, dict):
            continue
        key = "%s|%s" % (agent_name, str(row.get("label") or "")[:64])
        row["pace"] = pace_for(row, key, live)
        pct = row.get("percent")
        resets = window_id(parse_iso_ms(row.get("resetsAt")))
        if not isinstance(pct, (int, float)) or pct < 0 or not resets:
            continue
        points = PACE["samples"].get(key) or []
        last = points[-1] if points else None
        # One line per window per five minutes, plus every real change: the
        # collector ticks every few seconds and this file is read whole.
        if last is None or last[2] != resets or abs(last[1] - pct) > 1e-9 or now_ms - last[0] >= SAMPLE_MIN_GAP_MS:
            PACE["next"].append(json.dumps({"ts": now_ms, "key": key, "pct": round(float(pct), 6), "resets": resets}))
    return agent_payload


def limits_for(agent):
    """Return (limits, measured_at_ms, status_text) for one agent record."""
    try:
        raw = json.loads((USAGE_DIR / f"{agent}.json").read_text())
    except (OSError, ValueError):
        return [], 0, ""
    if not isinstance(raw, dict):
        return [], 0, ""
    out = raw.get("limits")
    limits = [{"label": str(l.get("label") or "")[:64],
               "percent": norm_percent(l.get("percent")),
               "resetsAt": str(l.get("resetsAt") or "")[:40]}
              for l in out if isinstance(l, dict)] if isinstance(out, list) else []
    updated = parse_iso_ms(raw.get("updatedAt"))
    measured = probe_measured_at(agent) or updated
    # A probe cache newer than the record cannot be what produced the record.
    if updated and measured > updated:
        measured = updated
    status = str(raw.get("usageStatusText") or "")[:120]
    if not status and raw.get("retryAdvised") is True and limits:
        status = "last probe failed, showing last known"
    return limits, measured, status


def limits_help(agent):
    """The remedy the record already knows, e.g. "Run `claude auth login`".

    Kept out of limits_for so that pick_limits and grok_limits_from_log keep
    speaking the same three-value shape; widening that tuple broke the Grok
    path, which chooses between two sources of the same kind.
    """
    try:
        raw = json.loads((USAGE_DIR / f"{agent}.json").read_text())
    except (OSError, ValueError):
        return ""
    if not isinstance(raw, dict):
        return ""
    return str(raw.get("authHelpText") or "")[:160]


def with_limits(agent_payload, agent_name):
    limits, measured, status = limits_for(agent_name)
    help_text = limits_help(agent_name)
    agent_payload["limits"] = limits
    agent_payload["limitsMeasuredAt"] = measured
    agent_payload["limitsStatus"] = status
    agent_payload["limitsHelp"] = help_text
    # Live: Burn Bar re-probes these records itself (limitsRefreshSec), so an old
    # measurement really does mean something is wrong and the figure is withheld.
    agent_payload["limitsLive"] = True
    return agent_payload


# Kimi's tier changes about never, and this runs on a 5-second loop, so it is
# fetched at most twice a day and a failure keeps the last known answer.
KIMI_PLAN_TTL_MS = 12 * 3600 * 1000


def kimi_api_key():
    """From the environment, else ~/.env. Never logged, and never passed as an
    argument: urllib keeps it out of argv, where any local process could read
    it off /proc."""
    key = (os.environ.get("KIMI_API_KEY") or "").strip()
    if key:
        return key
    try:
        for line in (HOME / ".env").read_text(errors="replace").splitlines():
            line = line.strip()
            if line.startswith("KIMI_API_KEY="):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return ""


# Usage moves with every call, so it is refreshed on roughly the same cadence
# Burn Bar re-probes Claude and Codex, not the tier's twice-a-day TTL.
KIMI_USAGE_TTL_MS = 240 * 1000


def kimi_window_label(window):
    """"5-hour" from {duration: 300, timeUnit: TIME_UNIT_MINUTE}."""
    try:
        n = int(window.get("duration") or 0)
    except (TypeError, ValueError):
        return ""
    unit = str(window.get("timeUnit") or "").replace("TIME_UNIT_", "").lower()
    if n <= 0 or not unit:
        return ""
    if unit == "minute" and n % 60 == 0:
        n, unit = n // 60, "hour"
    return "%d-%s" % (n, unit)


def kimi_limits_from_usages(raw):
    """Burn Bar's {label, percent, resetsAt} rows from Kimi's /usages payload.

    Two different measures come back. `limits[]` is the request window that
    actually cuts you off (8 of 100 in five hours); `usages` carries credit
    ratios for that same window and for the month. The request window is the
    binding one, so it wins the 5-hour row and the duplicate credit ratio for
    the same span is dropped rather than printed twice.
    """
    out = []
    seen_hours = set()
    for entry in (raw.get("limits") or []):
        if not isinstance(entry, dict):
            continue
        window = entry.get("window") if isinstance(entry.get("window"), dict) else {}
        detail = entry.get("detail") if isinstance(entry.get("detail"), dict) else {}
        label = kimi_window_label(window)
        try:
            limit = float(detail.get("limit") or 0)
            used = float(detail.get("used") or 0)
        except (TypeError, ValueError):
            continue
        if not label or limit <= 0:
            continue
        seen_hours.add(label)
        out.append({"label": "Session (%s)" % label,
                    "percent": max(0.0, min(1.0, used / limit)),
                    "resetsAt": str(detail.get("resetTime") or "")})
    names = {"limit_5h": ("Session (5-hour)", "5-hour"),
             "limit_month_total": ("Monthly (total)", ""),
             "limit_month_code": ("Monthly (code)", "")}
    for key, (label, span) in names.items():
        entry = (raw.get("usages") or {}).get(key)
        if not isinstance(entry, dict):
            continue
        if span and span in seen_hours:
            continue  # the request window above already speaks for this span
        try:
            ratio = float(entry.get("used_ratio") or 0)
        except (TypeError, ValueError):
            continue
        out.append({"label": label,
                    "percent": max(0.0, min(1.0, ratio)),
                    "resetsAt": str(entry.get("reset_time") or "")})
    return out


def refresh_kimi_usage():
    """Kimi's real quota. GET /usages (plural); /usage is a 404, which is how
    this was first written off as unavailable."""
    path = OUT_DIR / "kimi-usage.json"
    try:
        cached = json.loads(path.read_text())
        if now_ms - int(cached.get("measuredAt") or 0) < KIMI_USAGE_TTL_MS:
            return
    except (OSError, ValueError, TypeError):
        pass
    key = kimi_api_key()
    if not key:
        return
    base = (os.environ.get("KIMI_BASE_URL") or "https://api.kimi.com/coding/v1").rstrip("/")
    if not base.startswith(("http://", "https://")):
        return
    try:
        req = urllib.request.Request(base + "/usages",
                                     headers={"Authorization": "Bearer " + key})
        with urllib.request.urlopen(req, timeout=5) as response:
            raw = json.loads(response.read(262144).decode("utf-8", "replace"))
        limits = kimi_limits_from_usages(raw if isinstance(raw, dict) else {})
    except (urllib.error.URLError, OSError, ValueError, TypeError):
        return  # keep the last good answer rather than blanking a real figure
    if not limits:
        return
    try:
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(OUT_DIR), prefix=".kimi-usage.", suffix=".tmp")
        with os.fdopen(fd, "w") as stream:
            stream.write(json.dumps({"limits": limits, "measuredAt": now_ms}))
        os.replace(tmp, path)
    except OSError:
        pass


def refresh_kimi_plan():
    """Cache Kimi's plan tier. The only thing Kimi will tell us about a
    subscription: /me carries user_level_name, and nothing anywhere carries a
    quota. Silent on every failure: a tier we cannot reach is not an error
    worth breaking a collection over."""
    path = OUT_DIR / "kimi-plan.json"
    try:
        cached = json.loads(path.read_text())
        if now_ms - int(cached.get("measuredAt") or 0) < KIMI_PLAN_TTL_MS:
            return
    except (OSError, ValueError, TypeError):
        pass
    key = kimi_api_key()
    if not key:
        return
    base = (os.environ.get("KIMI_BASE_URL") or "https://api.kimi.com/coding/v1").rstrip("/")
    if not base.startswith(("http://", "https://")):
        return
    try:
        req = urllib.request.Request(base + "/me",
                                     headers={"Authorization": "Bearer " + key})
        with urllib.request.urlopen(req, timeout=4) as response:
            data = json.loads(response.read(65536).decode("utf-8", "replace"))
        tier = str((data or {}).get("user_level_name") or "")[:40]
    except (urllib.error.URLError, OSError, ValueError, TypeError):
        return
    if not tier:
        return
    try:
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(OUT_DIR), prefix=".kimi-plan.", suffix=".tmp")
        with os.fdopen(fd, "w") as stream:
            stream.write(json.dumps({"tier": tier, "measuredAt": now_ms}))
        os.replace(tmp, path)
    except OSError:
        pass


def with_kimi_plan(agent_payload):
    """Kimi's real quota, from GET /usages, plus the tier from /me.

    Live, because Burn Bar re-probes it itself on the usage TTL: an old
    measurement really does mean something is wrong, and the figure is withheld
    the same way Claude's and Codex's are.
    """
    limits = []
    measured = 0
    try:
        raw = json.loads((OUT_DIR / "kimi-usage.json").read_text())
        if isinstance(raw, dict) and isinstance(raw.get("limits"), list):
            limits = raw["limits"]
            measured = int(raw.get("measuredAt") or 0)
    except (OSError, ValueError, TypeError):
        pass
    tier = ""
    try:
        plan = json.loads((OUT_DIR / "kimi-plan.json").read_text())
        if isinstance(plan, dict):
            tier = str(plan.get("tier") or "")[:40]
    except (OSError, ValueError, TypeError):
        pass
    agent_payload["limits"] = limits
    agent_payload["limitsLive"] = True
    agent_payload["limitsHelp"] = "Check KIMI_API_KEY in ~/.env" if not limits else ""
    agent_payload["planTier"] = tier
    agent_payload["limitsMeasuredAt"] = measured
    # The tier is worth saying once; it is not a fault, so it stays dim.
    agent_payload["limitsStatus"] = ("%s plan" % tier) if (tier and not limits) else ""
    agent_payload["limitsInfo"] = True
    return agent_payload


refresh_kimi_plan()
refresh_kimi_usage()
PACE["samples"] = load_samples()
all_burn = claude.total + codex.total + grok.total + kimi.total + zcode.total + local.total
payload = {
    "generatedAt": now_ms,
    "windowMinutes": WINDOW_MIN,
    "bucketMinutes": BUCKET_MS / 60_000,
    "bucketCount": BUCKETS,
    "buckets": buckets,
    "claude": with_pace(with_limits(claude.payload(), "claude"), "claude"),
    "codex": with_pace(with_limits(codex.payload(), "codex"), "codex"),
    # Grok is a SNAPSHOT, not a live probe: nothing re-probes it, and Grok Bot
    # writes "billing: fetched credits config" only when it starts (44 lines in
    # six days on gus, 2026-09-18). Judging it by measurement age blanked the
    # weekly row within 15 minutes and left it blank for days; its own billing
    # window (resetsAt) is what says whether the figure still describes now.
    "grok": with_pace(dict(with_grok_limits(grok.payload()), limitsLive=False,
                           lastWriteAt=GROK_NEWEST["ms"]), "grok"),
    "kimi": with_pace(with_kimi_plan(kimi.payload()), "kimi"),
    # Zcode is burn-only: no plan meter is read (Z.ai's quota endpoint is
    # undocumented and not probed), so there are no limits rows and no pace.
    # limitsLive false keeps the panel from demanding a measurement time for
    # figures that were never claimed to exist.
    "zcode": with_pace(dict(zcode.payload(), limitsLive=False), "zcode"),
    # Local tokens over the same exact window, and the share of everything
    # that burned on this machine which never went to a frontier model.
    "local": dict(local.payload(), available=local_available, reason=local_reason,
                  host=METER_HOST, unit=METER_UNIT),
    "offloadShare": (local.total / all_burn) if all_burn > 0 else 0,
    # Which agents this machine actually uses. The strip hides the rest.
    "presence": {
        "claude": claude_present,
        "codex": codex_present,
        "grok": grok_present,
        "kimi": kimi_present,
        "zcode": zcode_present,
    },
}


def write_atomic(target, text):
    """Unique temp file in the target's directory, then rename: a second
    collector sharing this state dir can never publish half of ours or
    trip over a shared temp name."""
    fd, tmp = tempfile.mkstemp(dir=str(target.parent), prefix="." + target.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# The state directory is the one thing that has to work. This runs as a widget
# subprocess, where a traceback in the journal says less than one clear line.
try:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    # One collector per state directory at a time. If another holds the lock it
    # is about to publish the same answer; leave quietly rather than race it.
    lock = open(LOCK_FILE, "w")
except OSError as e:
    sys.exit("burnbar-collect: cannot use %s: %s" % (OUT_DIR, e.strerror or e))
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)

# allow_nan=False: a NaN would serialise as a bare NaN token, which is not JSON
# and would leave the widget holding whatever it parsed last.
try:
    write_atomic(OUT_FILE, json.dumps(payload, allow_nan=False))
except OSError as e:
    sys.exit("burnbar-collect: cannot write %s: %s" % (OUT_FILE, e.strerror or e))
try:
    write_atomic(CACHE_FILE, json.dumps({"v": CACHE_VERSION, "files": next_cache}, allow_nan=False))
except (OSError, ValueError):
    pass  # the cache is an optimisation; losing it only costs one slow run

# The percentage samples the pace maths reads next run. Written after the
# payload: a sample the widget never saw is worse than one written a tick late.
save_samples()

if "--print" in sys.argv:
    print(json.dumps(payload, indent=2))
